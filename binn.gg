})

Tabs.EspTab:Slider({
    Title    = "Max Distance",
    Min      = 100,
    Max      = 5000,
    Default  = 2000,
    Suffix   = " studs",
    Callback = function(v) Config.ESP.MaxDistance = v end,
})

-- ─── GUN TAB ──────────────────────────────────────────────────────────────────

do
    local gunMultiSection = Tabs.GunTab:MultiSection({ Title = "Gun Mods", Desc = "reminder everyone can see this..", Icon = "rbxassetid://74707737394329", Opened = true, Box = true, BoxBorder = true })

    local gunModsTab    = gunMultiSection:Tab({ Title = "Mods",    Icon = "rbxassetid://74707737394329",      Selected = true  })
    local gunSlidersTab = gunMultiSection:Tab({ Title = "Sliders", Icon = "target",     Selected = false })
    local gunServerTab  = gunMultiSection:Tab({ Title = "Bullets",  Icon = "server",      Selected = false })
    local gunSoundsTab  = gunMultiSection:Tab({ Title = "Sounds",  Icon = "music",       Selected = false })

    local GunTogglesSection = gunModsTab
    local XenoModsSection   = gunModsTab
    local GunSlidersSection = gunSlidersTab
    local BulletModSection  = gunServerTab
    local SoundsSection     = gunSoundsTab

    local LP        = S.LocalPlayer
    local RunSvc    = Services.RunService
    local RS        = Services.ReplicatedStorage

    -- ── WEAPON MOD ENGINE ──────────────────────────────────────────────────────

    local Mods = {
        InfiniteAmmo       = false, InfiniteClips    = false,
        InfiniteDamage     = false, Automatic        = false,
        RainbowGuns        = false, ModifyFireRate   = false,
        ModifyReloadSpeed  = false, ModifyEquipSpeed = false,
        ModifySpreadValue  = false, ModifyRecoilValue= false,
        DisableJamming     = false,
        FireRateSpeed      = 60,   ReloadSpeed       = 50,
        EquipSpeed         = 50,   SpreadPercentage  = 50,
        RecoilPercentage   = 50,
    }

    local OldWeaponValues = {}
    local SetInfiniteAmmo, SetInfiniteClips = nil, nil

    local function GetAllTools(localOnly)
        local result = {}
        local sources = { not localOnly and game:GetService("Lighting"), LP.Backpack, LP.Character }
        for _, src in next, sources do
            if type(src) == "userdata" then
                for _, v in next, src:GetChildren() do result[#result + 1] = v end
            end
        end
        return result
    end

    local function GetPct(base, pct)
        return base * (math.max(0, math.min(100, pct)) / 100)
    end

    local function ModWeapon(Weapon)
        local Module = Weapon:FindFirstChildOfClass("ModuleScript")
        if not (Module and Module.Name == "Setting") then return end
        Module = require(Module)
        local Old = OldWeaponValues[Weapon.Name]
        if not Old then return end

        if SetInfiniteAmmo == nil then SetInfiniteAmmo = true end
        if SetInfiniteClips == nil then SetInfiniteClips = true end

        local gs = getsenv(Weapon:FindFirstChild("GunScript_Local"))
        if Mods.InfiniteClips then
            debug.setupvalue(gs.Reload, 3, 10000); SetInfiniteClips = true
        elseif SetInfiniteClips == true then
            debug.setupvalue(gs.Reload, 3, Old.AmmoPerMag); SetInfiniteClips = false
        end

        if Mods.InfiniteAmmo then
            debug.setupvalue(gs.Reload, 1, 1e1); SetInfiniteAmmo = true
        elseif SetInfiniteAmmo == false then
            debug.setupvalue(gs.Reload, 1, Old.AmmoPerMag); SetInfiniteAmmo = false
        end

        Module.LimitedAmmoEnabled = false
        Module.FireRate    = Mods.ModifyFireRate    and GetPct(Old.FireRate,   Mods.FireRateSpeed)    or Old.FireRate
        Module.ReloadTime  = Mods.ModifyReloadSpeed and GetPct(Old.ReloadTime, Mods.ReloadSpeed)      or Old.ReloadTime
        Module.EquipTime   = Mods.ModifyEquipSpeed  and GetPct(Old.EquipTime,  Mods.EquipSpeed)       or Old.EquipTime
        Module.Recoil      = Mods.ModifyRecoilValue and GetPct(Old.Recoil,     Mods.RecoilPercentage) or Old.Recoil
        Module.BaseDamage  = Mods.InfiniteDamage    and math.huge or Old.BaseDamage
        Module.Auto        = Mods.Automatic         or Old.Auto
        Module.JamChance   = Mods.DisableJamming    and 0 or Old.JamChance
        if Module.SpreadXY then Module.SpreadXY = Mods.ModifySpreadValue and GetPct(Old.SpreadXY, Mods.SpreadPercentage) or Old.SpreadXY end
        if Module.SpreadYX then Module.SpreadYX = Mods.ModifySpreadValue and GetPct(Old.SpreadYX, Mods.SpreadPercentage) or Old.SpreadYX end
        if Module.Spread   then Module.Spread   = Mods.ModifySpreadValue and GetPct(Old.Spread,   Mods.SpreadPercentage) or Old.Spread   end
        Module.SpreadX = Mods.ModifySpreadValue and GetPct(Old.SpreadX, Mods.SpreadPercentage) or Old.SpreadX
        Module.SpreadY = Mods.ModifySpreadValue and GetPct(Old.SpreadY, Mods.SpreadPercentage) or Old.SpreadY
    end

    local function ModWeapons()
        for _, w in next, GetAllTools(true) do if w:IsA("Tool") then ModWeapon(w) end end
    end

    local function SetValues()
        for _, w in next, GetAllTools() do
            if w:IsA("Tool") then
                local m = w:FindFirstChildOfClass("ModuleScript")
                if m and m.Name == "Setting" then m = require(m) end
                if type(m) == "table" and not OldWeaponValues[w.Name] then
                    OldWeaponValues[w.Name] = {}
                    for k, v in next, m do OldWeaponValues[w.Name][k] = v end
                end
            end
        end
    end

    if not LP.Character then LP.CharacterAdded:Wait() end

    local function hookTool(v)
        if not v:IsA("Tool") then return end
        SetValues(); ModWeapon(v)
    end

    LP.Character.ChildAdded:Connect(hookTool)
    LP.Backpack.ChildAdded:Connect(hookTool)
    LP.CharacterAdded:Connect(function(char)
        char.ChildAdded:Connect(hookTool)
        LP.Backpack.ChildAdded:Connect(hookTool)
    end)

    -- ── RAINBOW GUNS ───────────────────────────────────────────────────────────

    local rainbowOriginals = {}
    local rainbowWasOn     = false

    local function applyRainbow(gun, hue)
        if not gun or not gun:IsA("Tool") then return end
        if not rainbowOriginals[gun] then
            rainbowOriginals[gun] = {}
            for _, p in ipairs(gun:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "Handle" then
                    rainbowOriginals[gun][p] = { Color = p.Color, Material = p.Material }
                end
            end
        end
        for _, p in ipairs(gun:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "Handle" then
                p.Color = Color3.fromHSV(hue, 1, 0.7)
                p.Material = Enum.Material.SmoothPlastic
            end
        end
    end

    local function restoreRainbow()
        for gun, parts in pairs(rainbowOriginals) do
            for p, d in pairs(parts) do
                if p and p.Parent then p.Color = d.Color; p.Material = d.Material end
            end
        end
        rainbowOriginals = {}
    end

    RunSvc.RenderStepped:Connect(function()
        if not Mods.RainbowGuns then
            if rainbowWasOn then restoreRainbow(); rainbowWasOn = false end
            return
        end
        rainbowWasOn = true
        local hue = (tick()) % 1
        if LP.Character then
            for _, t in ipairs(LP.Character:GetChildren()) do if t:IsA("Tool") then applyRainbow(t, hue) end end
        end
        for _, t in ipairs(LP.Backpack:GetChildren()) do if t:IsA("Tool") then applyRainbow(t, hue) end end
    end)

    -- ── TOGGLES ────────────────────────────────────────────────────────────────

    local function modToggle(sec, title, key)
        sec:Toggle({ Title = title, Value = false, Callback = function(v) Mods[key] = v; ModWeapons() end })
    end

    modToggle(GunTogglesSection, "Infinite Ammo",       "InfiniteClips")
    modToggle(GunTogglesSection, "Infinite Clips",      "InfiniteAmmo")
    modToggle(GunTogglesSection, "One Tap",             "InfiniteDamage")
    modToggle(GunTogglesSection, "Fully Automatic",     "Automatic")
    modToggle(GunTogglesSection, "Rainbow Weapons",     "RainbowGuns")
    modToggle(GunSlidersSection, "Modify Fire Rate",    "ModifyFireRate")
    modToggle(GunSlidersSection, "Modify Reload Speed", "ModifyReloadSpeed")
    modToggle(GunSlidersSection, "Modify Equip Speed",  "ModifyEquipSpeed")
    modToggle(GunSlidersSection, "Modify Spread Value", "ModifySpreadValue")
    modToggle(GunSlidersSection, "Modify Recoil Value", "ModifyRecoilValue")
    modToggle(GunSlidersSection, "Disable Jamming",     "DisableJamming")

    -- ── SLIDERS ────────────────────────────────────────────────────────────────

    GunSlidersSection:Slider({ Title = "Fire Rate %",    Min = 30,  Max = 100, Default = 60, Callback = function(v) Mods.FireRateSpeed    = v; if Mods.ModifyFireRate    then ModWeapons() end end })
    GunSlidersSection:Slider({ Title = "Spread %",       Min = 0,   Max = 100, Default = 50, Callback = function(v) Mods.SpreadPercentage  = v; if Mods.ModifySpreadValue then ModWeapons() end end })
    GunSlidersSection:Slider({ Title = "Recoil %",       Min = 0,   Max = 100, Default = 50, Callback = function(v) Mods.RecoilPercentage  = v; if Mods.ModifyRecoilValue then ModWeapons() end end })
    GunSlidersSection:Slider({ Title = "Reload Speed %", Min = 0,   Max = 100, Default = 50, Callback = function(v) Mods.ReloadSpeed       = v; if Mods.ModifyReloadSpeed then ModWeapons() end end })
    GunSlidersSection:Slider({ Title = "Equip Speed %",  Min = 0,   Max = 100, Default = 50, Callback = function(v) Mods.EquipSpeed        = v; if Mods.ModifyEquipSpeed  then ModWeapons() end end })

    -- ── XENO / MOBILE INF AMMO ─────────────────────────────────────────────────

    XenoModsSection:Button({
        Title = "Inf Ammo (Xeno)",
        Callback = function()
            for _, v in ipairs(LP.Character:GetChildren()) do
                if v:IsA("Tool") and v:FindFirstChild("GunScript_Server") then
                    v.GunScript_Server:WaitForChild("ChangeMagAndAmmo"):FireServer(99999, 0)
                end
            end
            WindUI:Notify({ Title = "Inf Ammo", Content = "Drop & re-equip your gun.", Icon = "check", Duration = 4 })
        end
    })

    XenoModsSection:Button({
        Title = "Inf Clips (Xeno)",
        Callback = function()
            for _, v in ipairs(LP.Character:GetChildren()) do
                if v:IsA("Tool") and v:FindFirstChild("GunScript_Server") then
                    local gun = v.GunScript_Server
                    local mag
                    if     gun:FindFirstChild("Mag")      and gun.Mag:IsA("NumberValue")             then mag = gun.Mag.Value
                    elseif gun:FindFirstChild("Ammo")     and gun.Ammo:IsA("NumberValue")            then mag = gun.Ammo.Value
                    elseif gun:FindFirstChild("Stats")    and gun.Stats:FindFirstChild("MagSize")    then mag = gun.Stats.MagSize.Value
                    elseif gun:FindFirstChild("Config")   and gun.Config:FindFirstChild("MagSize")   then mag = gun.Config.MagSize.Value
                    elseif gun:FindFirstChild("Settings") and gun.Settings:FindFirstChild("MagSize") then mag = gun.Settings.MagSize.Value
                    end
                    if mag then gun:WaitForChild("ChangeMagAndAmmo"):FireServer(mag, 99999) end
                end
            end
            WindUI:Notify({ Title = "Inf Clips", Content = "Drop & re-equip your gun.", Icon = "check", Duration = 4 })
        end
    })

    -- ── CUSTOM FIRE SOUNDS ─────────────────────────────────────────────────────

    local SoundCFG = {
        Enabled = false, CurrentId = "",
        List = {
            { Name = "Neverlose Classic", Id = "rbxassetid://8679627751"      },
            { Name = "Fatality",          Id = "rbxassetid://138378419413244" },
            { Name = "Bubble Pop",        Id = "rbxassetid://119697580657161" },
            { Name = "Realistic",         Id = "rbxassetid://2781019930"      },
            { Name = "Christmas Bells",   Id = "rbxassetid://100156067670983" },
            { Name = "RayGun",            Id = "rbxassetid://131179973"       },
        }
    }

    local OriginalSounds = {}

    local function ApplyToTool(tool)
        for _, obj in ipairs(tool:GetDescendants()) do
            if obj:IsA("Sound") and obj.Parent.Name == "FireSounds" then
                if not OriginalSounds[obj] then OriginalSounds[obj] = obj.SoundId end
                obj.SoundId = (SoundCFG.Enabled and SoundCFG.CurrentId ~= "") and SoundCFG.CurrentId or OriginalSounds[obj]
            end
        end
    end

    local function ScanContainer(container)
        for _, obj in ipairs(container:GetChildren()) do if obj:IsA("Tool") then ApplyToTool(obj) end end
        container.ChildAdded:Connect(function(obj)
            if obj:IsA("Tool") then task.wait(0.1); ApplyToTool(obj) end
        end)
    end

    ScanContainer(LP.Backpack)
    if LP.Character then ScanContainer(LP.Character) end
    LP.CharacterAdded:Connect(function(char) ScanContainer(char) end)

    local SoundNames = {}
    for _, s in ipairs(SoundCFG.List) do table.insert(SoundNames, s.Name) end

    local function refreshSounds()
        if LP.Character then for _, t in ipairs(LP.Character:GetChildren()) do if t:IsA("Tool") then ApplyToTool(t) end end end
        for _, t in ipairs(LP.Backpack:GetChildren()) do if t:IsA("Tool") then ApplyToTool(t) end end
    end

    SoundsSection:Dropdown({
        Title   = "Select Sound",
        Options = SoundNames,
        Callback = function(val)
            for _, s in ipairs(SoundCFG.List) do
                if s.Name == val then SoundCFG.CurrentId = s.Id; break end
            end
            refreshSounds()
        end
    })

    SoundsSection:Toggle({
        Title = "Enable Custom Sound", Value = false,
        Callback = function(v) SoundCFG.Enabled = v; refreshSounds() end
    })

    -- ── SERVERSIDE BULLET MODS ─────────────────────────────────────────────────

    local modEnabled      = false
    local modLightOn      = false
    local modParticleOn   = false
    local modLightColor   = Color3.new(1, 1, 1)
    local modParticleColor= Color3.new(1, 0, 0)
    local modSpeed        = 275
    local modGravity      = 0.3
    local modMeshScale    = Vector3.new(4, 4, 4)
    local modSize         = Vector3.new(4, 4, 4)
    local modMaterial     = Enum.Material.Neon
    local origVals        = {}

    local function storeOrig(v)
        if origVals[v] then return end
        origVals[v] = {
            BulletSpeed = v.BulletSpeed, DropGravity = v.DropGravity,
            BulletMeshEnabled = v.BulletMeshEnabled, BulletMeshID = v.BulletMeshID,
            BulletTextureID = v.BulletTextureID, BulletMeshScale = v.BulletMeshScale,
            BulletSize = v.BulletSize, BulletTransparency = v.BulletTransparency,
            BulletMaterial = v.BulletMaterial, BulletLightEnabled = v.BulletLightEnabled,
            BulletLightBrightness = v.BulletLightBrightness, BulletLightRange = v.BulletLightRange,
            BulletLightColor = v.BulletLightColor, BulletParticleEnaled = v.BulletParticleEnaled,
            BulletParticleColor = v.BulletParticleColor, BulletParticleSize = v.BulletParticleSize,
            BulletParticleRate = v.BulletParticleRate, BulletParticleLifetime = v.BulletParticleLifetime,
            BulletParticleSpeed = v.BulletParticleSpeed, BulletParticleTexture = v.BulletParticleTexture,
            BulletTracerEnabled = v.BulletTracerEnabled, BulletTrailEnabled = v.BulletTrailEnabled,
        }
    end

    local function restoreOrig(v)
        local o = origVals[v]
        if o then for k, vv in pairs(o) do v[k] = vv end end
    end

    local function applyMod()
        for _, v in getgc(true) do
            if typeof(v) == "table" and rawget(v, "BulletSpeed") then
                storeOrig(v)
                v.BulletSpeed = modSpeed; v.DropGravity = modGravity
                v.BulletMeshEnabled = false; v.BulletMeshScale = modMeshScale
                v.BulletSize = modSize; v.BulletTransparency = 1; v.BulletMaterial = modMaterial
                v.BulletLightEnabled = modLightOn; v.BulletLightBrightness = 9e9; v.BulletLightRange = 99999
                if v.BulletLightColor then v.BulletLightColor = modLightColor end
                v.BulletParticleEnaled = modParticleOn
                if v.BulletParticleColor then v.BulletParticleColor = modParticleColor end
                v.BulletParticleSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, 9e9), NumberSequenceKeypoint.new(1, 1) })
                v.BulletParticleRate = 9e9
                v.BulletParticleLifetime = NumberRange.new(9e9, 9e9)
                v.BulletParticleSpeed = NumberRange.new(0.3, 9e9)
                v.BulletTracerEnabled = true; v.BulletTrailEnabled = true
            end
        end
    end

    local function restoreMod()
        for _, v in getgc(true) do
            if typeof(v) == "table" and rawget(v, "BulletSpeed") then restoreOrig(v) end
        end
    end

    BulletModSection:Toggle({
        Title = "Enable Bullet Mod", Value = false,
        Callback = function(val)
            modEnabled = val
            if val then applyMod(); WindUI:Notify({ Title = "Bullet Mod On",  Icon = "zap",   Duration = 3 })
            else       restoreMod(); WindUI:Notify({ Title = "Bullet Mod Off", Icon = "zap-off", Duration = 3 }) end
        end
    })

    BulletModSection:Toggle({
        Title = "Flashbang Bullet", Value = false,
        Callback = function(val) modLightOn = val; if modEnabled then applyMod() end end
    })

    BulletModSection:Toggle({
        Title = "Flame Bullet", Value = false,
        Callback = function(val) modParticleOn = val; if modEnabled then applyMod() end end
    })

    -- ── TORNADO BULLETS ────────────────────────────────────────────────────────

    local tornadoOn       = false
    local tornadoSpeed    = 250
    local tornadoOriginals= {}

    local function storeTornado(v)
        if tornadoOriginals[v] then return end
        tornadoOriginals[v] = {
            BulletSpeed = v.BulletSpeed, DropGravity = v.DropGravity,
            BulletSize = v.BulletSize, BulletTransparency = v.BulletTransparency,
            BulletMeshEnabled = v.BulletMeshEnabled, BulletMeshID = v.BulletMeshID,
            BulletTextureID = v.BulletTextureID, BulletMeshScale = v.BulletMeshScale,
        }
    end

    local function restoreTornado(v)
        local o = tornadoOriginals[v]
        if o then for k, vv in pairs(o) do v[k] = vv end end
    end

    local function applyTornado()
        for _, v in getgc(true) do
            if typeof(v) == "table" and rawget(v, "BulletSpeed") then
                storeTornado(v)
                v.BulletSpeed = tornadoSpeed; v.DropGravity = 0
                v.BulletSize = Vector3.new(1,1,1); v.BulletMeshScale = Vector3.new(1,1,1)
                v.BulletTransparency = 0; v.BulletMeshEnabled = true
                v.BulletMeshID    = "rbxassetid://92551368238826"
                v.BulletTextureID = "rbxassetid://92551368238826"
            end
        end
    end

    local function revertTornado()
        for _, v in getgc(true) do
            if typeof(v) == "table" and rawget(v, "BulletSpeed") then restoreTornado(v) end
        end
        if modEnabled then applyMod() end
    end

    BulletModSection:Toggle({
        Title = "Tornado Bullets", Value = false,
        Callback = function(val)
            tornadoOn = val
            if val then applyTornado(); WindUI:Notify({ Title = "Tornado On",  Icon = "wind", Duration = 3 })
            else       revertTornado(); WindUI:Notify({ Title = "Tornado Off", Icon = "wind", Duration = 3 }) end
        end
    })

    BulletModSection:Slider({
        Title = "Tornado Speed", Min = 1, Max = 500, Default = 250,
        Callback = function(val) tornadoSpeed = val; if tornadoOn then applyTornado() end end
    })

    -- ── SPRAY PAINT BULLETS ────────────────────────────────────────────────────

    local SPRAY_TEXTURE = {86197898387643}
    local sprayState = {
        enabled = false, size = 12, visibleTime = 100, fadeTime = 12,
        backups = setmetatable({}, { __mode = "k" }),
    }

    local function sprayBackup(t)
        if sprayState.backups[t] then return end
        local inner = rawget(t, 1)
        sprayState.backups[t] = {
            BulletHoleEnabled = rawget(t,"BulletHoleEnabled"), BulletHoleSize = rawget(t,"BulletHoleSize"),
            BulletHoleVisibleTime = rawget(t,"BulletHoleVisibleTime"), BulletHoleFadeTime = rawget(t,"BulletHoleFadeTime"),
            BulletHoleTexture = rawget(t,"BulletHoleTexture"),
            inner1 = (typeof(inner) == "table") and rawget(inner, 1) or nil,
        }
    end

    local function sprayRestore(t)
        local b = sprayState.backups[t]
        if not b then return end
        rawset(t,"BulletHoleEnabled",b.BulletHoleEnabled); rawset(t,"BulletHoleSize",b.BulletHoleSize)
        rawset(t,"BulletHoleVisibleTime",b.BulletHoleVisibleTime); rawset(t,"BulletHoleFadeTime",b.BulletHoleFadeTime)
        rawset(t,"BulletHoleTexture",b.BulletHoleTexture)
        local inner = rawget(t, 1)
        if typeof(inner) == "table" then rawset(inner, 1, b.inner1) end
    end

    local function sprayApply(t)
        if typeof(t) ~= "table" or not rawget(t,"BulletHoleEnabled") then return end
        sprayBackup(t)
        rawset(t,"BulletHoleEnabled",true); rawset(t,"BulletHoleSize",sprayState.size)
        rawset(t,"BulletHoleVisibleTime",sprayState.visibleTime); rawset(t,"BulletHoleFadeTime",sprayState.fadeTime)
        rawset(t,"BulletHoleTexture",SPRAY_TEXTURE)
        local inner = rawget(t, 1)
        if typeof(inner) == "table" then rawset(inner, 1, SPRAY_TEXTURE) end
    end

    local function sprayApplyAll()
        for _, v in getgc(true) do
            if typeof(v) == "table" then
                pcall(function()
                    sprayApply(v)
                    for _, k in {7, 8} do sprayApply(rawget(v, k)) end
                end)
            end
        end
    end

    local function sprayRestoreAll()
        for t in pairs(sprayState.backups) do pcall(function() sprayRestore(t) end) end
    end

    BulletModSection:Toggle({
        Title = "SprayPaint Bullets", Value = false,
        Callback = function(enabled)
            sprayState.enabled = enabled
            if enabled then sprayApplyAll(); WindUI:Notify({ Title = "SprayPaint On",  Icon = "paintbrush", Duration = 3 })
            else            sprayRestoreAll(); WindUI:Notify({ Title = "SprayPaint Off", Icon = "paintbrush", Duration = 3 }) end
        end
    })

    BulletModSection:Slider({
        Title = "Spray Size", Min = 1, Max = 150, Default = 12,
        Callback = function(val) sprayState.size = val; if sprayState.enabled then sprayApplyAll() end end
    })

    BulletModSection:Slider({
        Title = "Spray Timing", Min = 0, Max = 200, Default = 100,
        Callback = function(val)
            sprayState.visibleTime = val; sprayState.fadeTime = 12
            if sprayState.enabled then sprayApplyAll() end
        end
    })
end

-- ─── ME TAB — PLAYER MODS ────────────────────────────────────────────────────

do
    local LP        = S.LocalPlayer
    local RS        = Services.ReplicatedStorage
    local RunSvc    = Services.RunService
    local UIS       = Services.UserInputService
    local PPS       = game:GetService("ProximityPromptService")
    local StarterGui= game:GetService("StarterGui")
    local Lighting  = game:GetService("Lighting")

    local PM = {
        InfiniteSleep         = false,
        InfiniteStamina       = false,
        InfiniteHunger        = false,
        InstantInteract       = false,
        FastRespawn           = false,
        RespawnWhereYouDied   = false,
        AutoPickupBags        = false,
        AutoPickupCash        = false,
        BypassLockedCars      = false,
        AntiLoseItems         = false,
        DisableCameraBobbing  = false,
        DisableBloodEffects   = false,
        NoRentPay             = false,
        PulseNameTag          = false,
        NoJumpCooldown        = false,
        NoFallDamage          = false,
    }

    -- ── TOGGLES ────────────────────────────────────────────────────────────────

    local function pmToggle(title, key)
        Tabs.MeTab:Toggle({ Title = title, Value = false, Callback = function(v) PM[key] = v end })
    end

    pmToggle("Infinite Sleep",        "InfiniteSleep")
    pmToggle("Infinite Stamina",      "InfiniteStamina")
    pmToggle("Infinite Hunger",       "InfiniteHunger")
    pmToggle("Instant Interact",      "InstantInteract")
    pmToggle("Faster Respawn",        "FastRespawn")
    pmToggle("Respawn Where U Died",  "RespawnWhereYouDied")
    pmToggle("Auto Loot Bags",        "AutoPickupBags")
    pmToggle("Auto Pick Cash",        "AutoPickupCash")
    pmToggle("Bypass Locked Cars",    "BypassLockedCars")
    pmToggle("Keep Items On Death",   "AntiLoseItems")
    pmToggle("Anti Camera Shake",     "DisableCameraBobbing")
    pmToggle("Anti Blood Effects",    "DisableBloodEffects")
    pmToggle("Anti Rent Pay",         "NoRentPay")
    pmToggle("Anti Jump Cooldown",    "NoJumpCooldown")
    pmToggle("Anti Fall Damage",      "NoFallDamage")
    pmToggle("Pulse Name Tag",        "PulseNameTag")

    -- ── RENDERSTEP LOOP ────────────────────────────────────────────────────────

    RunSvc.RenderStepped:Connect(function()
        -- Infinite Stamina
        local runGui = LP.PlayerGui:FindFirstChild("Run")
        if runGui then
            local s = runGui:FindFirstChild("StaminaBarScript", true)
            if s then s.Disabled = PM.InfiniteStamina end
        end

        -- Infinite Hunger
        local hungerGui = LP.PlayerGui:FindFirstChild("Hunger")
        if hungerGui then
            local s = hungerGui:FindFirstChild("HungerBarScript", true)
            if s then s.Disabled = PM.InfiniteHunger end
        end

        -- Infinite Sleep
        local sleepGui = LP.PlayerGui:FindFirstChild("SleepGui")
        if sleepGui then
            local s = sleepGui:FindFirstChild("sleepScript", true)
            if s then s.Disabled = PM.InfiniteSleep end
        end

        -- Anti Camera Shake
        if LP.Character then
            local bob = LP.Character:FindFirstChild("CameraBobbing")
            if bob then bob.Disabled = PM.DisableCameraBobbing end
        end

        -- Anti Fall Damage
        if LP.Character then
            local fall = LP.Character:FindFirstChild("FallDamageRagdoll")
            if fall then fall.Disabled = PM.NoFallDamage end
        end

        -- Anti Blood Effects
        local bloodGui = LP.PlayerGui:FindFirstChild("BloodGui")
        if bloodGui then bloodGui.Enabled = not PM.DisableBloodEffects end

        -- Anti Rent Pay
        local rentGui = LP.PlayerGui:FindFirstChild("RentGui")
        if rentGui then
            local s = rentGui:FindFirstChild("LocalScript")
            if s then s.Disabled = PM.NoRentPay end
        end

        -- Auto Loot Bags
        if PM.AutoPickupBags and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and workspace:FindFirstChild("Storage") then
            local hrp = LP.Character.HumanoidRootPart
            for _, v in pairs(workspace.Storage:GetChildren()) do
                if v:IsA("MeshPart") then
                    local owner  = v:FindFirstChild("PlayerName")
                    local prompt = v:FindFirstChild("stealprompt")
                    if prompt and (not owner or owner.Value ~= LP.Name) and (v.Position - hrp.Position).Magnitude < 5 then
                        fireproximityprompt(prompt)
                    end
                end
            end
        end

        -- Auto Pick Cash
        if PM.AutoPickupCash and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and workspace:FindFirstChild("Dollas") then
            local hrp = LP.Character.HumanoidRootPart
            for _, v in pairs(workspace.Dollas:GetChildren()) do
                if v:IsA("Part") then
                    local prompt = v:FindFirstChild("ProximityPrompt")
                    if prompt and (v.Position - hrp.Position).Magnitude < 5 then
                        fireproximityprompt(prompt)
                    end
                end
            end
        end
    end)

    -- ── FAST RESPAWN ───────────────────────────────────────────────────────────

    local FIRE_INTERVAL = 0.15
    local lastFire      = 0
    local humanoid

    local function hookCharacterFR(char)
        humanoid = char:WaitForChild("Humanoid")
    end

    if LP.Character then hookCharacterFR(LP.Character) end
    LP.CharacterAdded:Connect(hookCharacterFR)

    RunSvc.PreRender:Connect(function()
        if not PM.FastRespawn or not humanoid then return end
        if humanoid:GetState() ~= Enum.HumanoidStateType.Dead then lastFire = 0; return end
        local now = os.clock()
        if now - lastFire < FIRE_INTERVAL then return end
        lastFire = now
        FireServer(RS.LoadCharacter)
        game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
    end)

    -- ── KEEP ITEMS ON DEATH ────────────────────────────────────────────────────

    local ExemptItems = {"Phone","Fist","Shiesty","Bandage","Lemonade","Car keys","Cuban","GunPermit"}

    local function MarketHasItem(name)
        local market = RS:FindFirstChild("MarketItems")
        if not market then return false end
        for _, item in ipairs(market:GetChildren()) do
            if item.Name == name and item:FindFirstChild("owner") and item.owner.Value == LP.Name then return true end
        end
        return false
    end

    local function BackpackHasItem(name)
        for _, t in ipairs(LP.Backpack:GetChildren()) do
            if t:IsA("Tool") and t.Name == name then return true end
        end
        return false
    end

    local function ForcePutToMarket(name)
        local endTime = os.clock() + 12
        while os.clock() < endTime do
            if MarketHasItem(name) then return true end
            pcall(function() RS.ListWeaponRemote:FireServer(name, 999999) end)
            task.wait(0.15)
        end
        return false
    end

    local function ForceRetrieveFromMarket(name)
        local market = RS:WaitForChild("MarketItems", 10)
        if not market then return false end
        local endTime = os.clock() + 12
        while os.clock() < endTime do
            for _, item in ipairs(market:GetChildren()) do
                if item.Name == name and item:FindFirstChild("owner") and item.owner.Value == LP.Name and item:GetAttribute("SpecialId") then
                    local special = item:GetAttribute("SpecialId")
                    pcall(function() RS.BuyItemRemote:FireServer(name, "Remove", special) end)
                    task.wait(0.2)
                    pcall(function() RS.BackpackRemote:InvokeServer("Grab", name) end)
                    task.wait(0.2)
                    if BackpackHasItem(name) then return true end
                end
            end
            task.wait(0.2)
        end
        return false
    end

    local function SaveOnDeath(char)
        local hum = char:WaitForChild("Humanoid")
        hum.Died:Connect(function()
            if not PM.AntiLoseItems then return end
            task.wait(0.25)
            for _, tool in ipairs(LP.Backpack:GetChildren()) do
                if tool:IsA("Tool") and not table.find(ExemptItems, tool.Name) then
                    ForcePutToMarket(tool.Name)
                end
            end
        end)
    end

    local function RetrieveAfterSpawn()
        task.delay(2.2, function()
            if not PM.AntiLoseItems then return end
            local market = RS:FindFirstChild("MarketItems")
            if not market then return end
            for _, item in ipairs(market:GetChildren()) do
                if item:FindFirstChild("owner") and item.owner.Value == LP.Name then
                    ForceRetrieveFromMarket(item.Name)
                end
            end
        end)
    end

    local function SetupAntiLose(char) SaveOnDeath(char); RetrieveAfterSpawn() end
    if LP.Character then SetupAntiLose(LP.Character) end
    LP.CharacterAdded:Connect(SetupAntiLose)

    -- ── RESPAWN WHERE YOU DIED ─────────────────────────────────────────────────

    local DeathFrame = nil

    local function SetupRespawn(char)
        local hum = char:WaitForChild("Humanoid")
        local hrp = char:WaitForChild("HumanoidRootPart")

        hum.Died:Connect(function() DeathFrame = hrp.CFrame end)

        if PM.RespawnWhereYouDied and typeof(DeathFrame) == "CFrame" then
            hrp.CFrame = DeathFrame
        end
    end

    if LP.Character then SetupRespawn(LP.Character) end
    LP.CharacterAdded:Connect(SetupRespawn)

    -- ── NO JUMP COOLDOWN ───────────────────────────────────────────────────────

    UIS.JumpRequest:Connect(function()
        if not PM.NoJumpCooldown then return end
        local char = LP.Character
        if not char then return end
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if not hum then return end
        if hum.FloorMaterial == Enum.Material.Air then return end
        if hum.Jump or hum:GetState() == Enum.HumanoidStateType.Jumping then return end
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end)

    -- ── INSTANT INTERACT / BYPASS LOCKED CARS ─────────────────────────────────

    PPS.PromptButtonHoldBegan:Connect(function(Prompt, Player)
        if Player ~= LP then return end

        if PM.InstantInteract then
            if fireproximityprompt then
                fireproximityprompt(Prompt)
            else
                local old = Prompt.HoldDuration
                Prompt.HoldDuration = 0
                task.wait()
                Prompt.HoldDuration = old
            end
        end

        if PM.BypassLockedCars then
            local char = LP.Character
            local hum  = char and char:FindFirstChild("Humanoid")
            if hum then
                local Seat = Prompt.Parent:FindFirstChildWhichIsA("VehicleSeat")
                    or Prompt.Parent:FindFirstAncestorWhichIsA("VehicleSeat")
                    or (Prompt.Parent.Parent and Prompt.Parent.Parent:FindFirstChildWhichIsA("VehicleSeat"))
                if Seat then Seat:Sit(hum) end
            end
        end
    end)

    -- ── PULSE NAME TAG ─────────────────────────────────────────────────────────

    local HEIGHT_OFFSET = 1.3
    local BASE_COLOR    = Color3.fromRGB(255, 0, 0)
    local DARK_COLOR    = Color3.fromRGB(139, 0, 0)
    local tagT          = 0

    local function createNameTag(character)
        local head = character:WaitForChild("Head")
        local billboard = Instance.new("BillboardGui")
        billboard.Name          = "NazuroNameTag"
        billboard.Size          = UDim2.new(0, 100, 0, 20)
        billboard.Adornee       = head
        billboard.StudsOffset   = Vector3.new(0, HEIGHT_OFFSET, 0)
        billboard.AlwaysOnTop   = true
        billboard.Parent        = head

        local outline = Instance.new("TextLabel")
        outline.Size                 = UDim2.fromScale(1, 1)
        outline.BackgroundTransparency = 1
        outline.TextScaled           = true
        outline.Font                 = Enum.Font.GothamBold
        outline.Text                 = "nazuro"
        outline.TextColor3           = Color3.new(0, 0, 0)
        outline.TextStrokeTransparency = 0
        outline.TextStrokeColor3     = Color3.new(0, 0, 0)
        outline.Parent               = billboard

        local label = outline:Clone()
        label.TextColor3             = BASE_COLOR
        label.TextStrokeTransparency = 1
        label.Parent                 = billboard

        return label, outline
    end

    local NazChar = LP.Character or LP.CharacterAdded:Wait()
    local NazText, NazOutline = createNameTag(NazChar)

    LP.CharacterAdded:Connect(function(char)
        NazChar = char
        NazText, NazOutline = createNameTag(char)
    end)

    RunSvc.RenderStepped:Connect(function(dt)
        if not PM.PulseNameTag then
            if NazText    then NazText.Visible    = false end
            if NazOutline then NazOutline.Visible = false end
            return
        end
        if NazText and NazOutline then
            tagT += dt * 1.2
            local pulse = (math.sin(tagT) + 1) / 2
            NazText.TextColor3 = BASE_COLOR:Lerp(DARK_COLOR, pulse * 0.25)
            NazText.Visible    = true
            NazOutline.Visible = true
        end
    end)
end

-- ============================
--        MONEY TAB / FARMS
-- ============================

do
    local LP     = S.LocalPlayer
    local RS     = S.ReplicatedStorage
    local WS     = S.Workspace
    local RunSvc = S.RunService

    local Farms = {
        FarmStudio          = false,
        FarmConstructionJob = false,
        FarmBank            = false,
        FarmHouses          = false,
        FarmTrash           = false,
        AutoSellTrash       = false,
        AFKCheck            = false,
    }

    -- ── UI TOGGLES ────────────────────────────────────────────────────────────

    Tabs.BankTab:Toggle({
        Title    = "AFK Check",
        Icon     = "shield",
        Value    = false,
        Callback = function(v) Farms.AFKCheck = v end,
    })

    Tabs.BankTab:Divider()

    Tabs.BankTab:Toggle({
        Title    = "AutoFarm | Studio",
        Icon     = "music",
        Value    = false,
        Callback = function(v) Farms.FarmStudio = v end,
    })

    Tabs.BankTab:Toggle({
        Title    = "AutoFarm | Construction",
        Icon     = "hammer",
        Value    = false,
        Callback = function(v)
            Farms.FarmConstructionJob = v
            if v then
                local char = LP.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    getgenv().ConstructionOldCFrame = char.HumanoidRootPart.CFrame
                end
            else
                task.spawn(function()
                    local construction = WS:FindFirstChild("ConstructionStuff")
                    if not construction then return end
                    local sp     = construction:FindFirstChild("Start Job")
                    local prompt = sp and sp:FindFirstChild("Prompt")
                    if prompt and prompt.Enabled then
                        local part = prompt.Parent
                        if part and part:IsA("BasePart") then
                            pcall(BypassTeleport, part.CFrame)
                            task.wait(0.1)
                            fireproximityprompt(prompt)
                        end
                    end
                    local char = LP.Character
                    if char and char:FindFirstChild("Humanoid") then
                        char.Humanoid:UnequipTools()
                    end
                end)
            end
        end,
    })

    Tabs.BankTab:Toggle({
        Title    = "AutoFarm | Bank",
        Icon     = "landmark",
        Value    = false,
        Callback = function(v) Farms.FarmBank = v end,
    })

    Tabs.BankTab:Toggle({
        Title    = "AutoFarm | Houses",
        Icon     = "house",
        Value    = false,
        Callback = function(v) Farms.FarmHouses = v end,
    })

    Tabs.BankTab:Toggle({
        Title    = "AutoFarm | Trash",
        Icon     = "trash",
        Value    = false,
        Callback = function(v)
            Farms.FarmTrash = v
            getgenv().TrashLoopRunning = v
        end,
    })

    Tabs.BankTab:Toggle({
        Title    = "Auto Sell Trash",
        Icon     = "coins",
        Value    = false,
        Callback = function(v) Farms.AutoSellTrash = v end,
    })

    -- ── BANKING OPTIONS ───────────────────────────────────────────────────────

    Tabs.BankTab:Divider()

    local Banking = {
        AutoDrop       = false,
        AutoDeposit    = false,
        AutoWithdraw   = false,
        DropAmount     = 50,
        DepositAmount  = 50,
        WithdrawAmount = 50,
    }

    -- Auto Drop loop
    task.spawn(function()
        while true do
            task.wait(0.5)
            if not Banking.AutoDrop then continue end
            pcall(function()
                S.ReplicatedStorage:WaitForChild("BankProcessRemote")
                    :InvokeServer("Drop", tostring(Banking.DropAmount))
                local giveMoney = S.ReplicatedStorage:FindFirstChild("GiveMoney")
                if giveMoney then
                    giveMoney:FireServer("drop", tostring(Banking.DropAmount))
                end
            end)
        end
    end)

    -- Auto Deposit loop
    task.spawn(function()
        while task.wait(0.25) do
            if not Banking.AutoDeposit then continue end
            pcall(function()
                S.ReplicatedStorage:WaitForChild("BankAction"):FireServer("depo", tostring(Banking.DepositAmount))
            end)
        end
    end)

    -- Auto Withdraw loop
    task.spawn(function()
        while task.wait(0.25) do
            if not Banking.AutoWithdraw then continue end
            pcall(function()
                S.ReplicatedStorage:WaitForChild("BankAction"):FireServer("with", tostring(Banking.WithdrawAmount))
            end)
        end
    end)

    Tabs.BankTab:Toggle({
        Title    = "Auto Drop Money",
        Icon     = "arrow-down",
        Desc     = "Drops your money on the ground on a loop.",
        Value    = false,
        Callback = function(v) Banking.AutoDrop = v end,
    })

    Tabs.BankTab:Slider({
        Title    = "Drop Amount",
        Icon     = "banknote",
        Min      = 1,
        Max      = 10000,
        Default  = 50,
        Callback = function(v) Banking.DropAmount = v end,
    })

    Tabs.BankTab:Toggle({
        Title    = "Auto Deposit",
        Icon     = "landmark",
        Desc     = "Auto-deposits to bank every 0.25s.",
        Value    = false,
        Callback = function(v) Banking.AutoDeposit = v end,
    })

    Tabs.BankTab:Slider({
        Title    = "Deposit Amount",
        Icon     = "banknote",
        Min      = 1,
        Max      = 30000,
        Default  = 50,
        Callback = function(v) Banking.DepositAmount = v end,
    })

    Tabs.BankTab:Toggle({
        Title    = "Auto Withdraw",
        Icon     = "wallet",
        Desc     = "Auto-withdraws from bank every 0.25s.",
        Value    = false,
        Callback = function(v) Banking.AutoWithdraw = v end,
    })

    Tabs.BankTab:Slider({
        Title    = "Withdraw Amount",
        Icon     = "banknote",
        Min      = 1,
        Max      = 90000,
        Default  = 50,
        Callback = function(v) Banking.WithdrawAmount = v end,
    })

    -- ── STUDIO FARM LOOP ──────────────────────────────────────────────────────

    task.spawn(function()
        while true do
            task.wait()
            if not Farms.FarmStudio then continue end

            local char = LP.Character
            local hum  = char and char:FindFirstChild("Humanoid")
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if not (char and hum and hrp and hum.Health > 0) then continue end

            local OldCFrame = hrp.CFrame

            local StudioPayFolder = WS:FindFirstChild("StudioPay")
            if not StudioPayFolder then pcall(BypassTeleport, OldCFrame); continue end

            local MoneyFolder = StudioPayFolder:FindFirstChild("Money")
            if not MoneyFolder then pcall(BypassTeleport, OldCFrame); continue end

            local function ActivatePrompt(p)
                if p and p.Enabled then
                    pcall(BypassTeleport, p.Parent.CFrame)
                    task.wait(0.1)
                    fireproximityprompt(p)
                    task.wait(0.1)
                end
            end

            ActivatePrompt(MoneyFolder:FindFirstChild("StudioPay1") and MoneyFolder.StudioPay1:FindFirstChild("Prompt", true))
            ActivatePrompt(MoneyFolder:FindFirstChild("StudioPay2") and MoneyFolder.StudioPay2:FindFirstChild("Prompt", true))
            ActivatePrompt(MoneyFolder:FindFirstChild("StudioPay3") and MoneyFolder.StudioPay3:FindFirstChild("Prompt", true))

            pcall(BypassTeleport, OldCFrame)

            if Farms.AFKCheck then
                task.wait(0.4)
                pcall(BypassTeleport, OldCFrame)
                task.wait(0.4)
            end
        end
    end)

    -- ── CONSTRUCTION FARM LOOP ────────────────────────────────────────────────

    task.spawn(function()
        local Construction = WS:WaitForChild("ConstructionStuff")
        local CachedWalls  = {}
        local StartPrompt2, GrabPrompt2

        for _, v in ipairs(Construction:GetChildren()) do
            if v:IsA("Part") then
                if v.Name:find("Wall") then
                    local p = v:FindFirstChild("Prompt")
                    if p then p.HoldDuration = 0; table.insert(CachedWalls, v) end
                elseif v.Name == "Start Job" then
                    StartPrompt2 = v:FindFirstChild("Prompt")
                    if StartPrompt2 then StartPrompt2.HoldDuration = 0 end
                elseif v.Name == "Grab Wood" then
                    GrabPrompt2 = v:FindFirstChild("Prompt")
                    if GrabPrompt2 then GrabPrompt2.HoldDuration = 0 end
                end
            end
        end

        local function GetFreeWall()
            for _, wall in ipairs(CachedWalls) do
                local p = wall:FindFirstChild("Prompt")
                if p and p.Enabled then return wall, p end
            end
        end

        while true do
            RunSvc.Heartbeat:Wait()
            if not Farms.FarmConstructionJob then task.wait(0.2); continue end

            local char = LP.Character
            local hum  = char and char:FindFirstChild("Humanoid")
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if not (char and hum and hrp and hum.Health > 0) then continue end

            if not LP:GetAttribute("WorkingJob") then
                if StartPrompt2 and StartPrompt2.Enabled then
                    BypassTeleport(StartPrompt2.Parent.CFrame)
                    task.wait(0.2)
                    fireproximityprompt(StartPrompt2)
                    repeat RunSvc.Heartbeat:Wait()
                    until LP:GetAttribute("WorkingJob") or not Farms.FarmConstructionJob
                end
                continue
            end

            getgenv().SwimMethod = true

            if not char:FindFirstChild("PlyWood") and not LP.Backpack:FindFirstChild("PlyWood") then
                if GrabPrompt2 and GrabPrompt2.Enabled then
                    BypassTeleport(GrabPrompt2.Parent.CFrame)
                    repeat
                        fireproximityprompt(GrabPrompt2)
                        RunSvc.Heartbeat:Wait()
                    until char:FindFirstChild("PlyWood")
                        or LP.Backpack:FindFirstChild("PlyWood")
                        or not Farms.FarmConstructionJob
                end
                continue
            end

            local PlyWood = LP.Backpack:FindFirstChild("PlyWood")
            if PlyWood then hum:EquipTool(PlyWood) end

            local wall, prompt = GetFreeWall()
            if wall and prompt then
                BypassTeleport(wall.CFrame)
                repeat
                    fireproximityprompt(prompt)
                    RunSvc.Heartbeat:Wait()
                until not char:FindFirstChild("PlyWood")
                    or not prompt.Enabled
                    or not Farms.FarmConstructionJob
            end
        end
    end)



    task.spawn(function()
        while true do
            task.wait()
            if not Farms.FarmBank then continue end

            local char = LP.Character
            local hum  = char and char:FindFirstChild("Humanoid")
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if not (char and hum and hrp and hum.Health > 0) then continue end

            local OldCFrame = hrp.CFrame
            local Robbable  = WS.vault.door.robPrompt.ProximityPrompt.Enabled

            if not Robbable then
                if Farms.AFKCheck then pcall(BypassTeleport, OldCFrame) end
                task.wait(0.2)
                continue
            end

            if not char:FindFirstChild("DuffelBag") then
                BypassTeleport(CFrame.new(-415, 339, -547))
                task.wait(0.2)
                fireproximityprompt(WS.dufflebagequip:FindFirstChildWhichIsA("ProximityPrompt"))
            end

            if not LP.Backpack:FindFirstChild("C4") and not char:FindFirstChild("C4") then
                BypassTeleport(CFrame.new(-414, 337, -565))
                task.wait(0.2)
                fireproximityprompt(WS.GUNS.C4.Handle.BuyPrompt)
            end

            repeat task.wait() until LP.Backpack:FindFirstChild("C4") or char:FindFirstChild("C4")

            hum:EquipTool(LP.Backpack:FindFirstChild("C4"))
            BypassTeleport(CFrame.new(-214, 374, -1215))
            task.wait(0.2)
            fireproximityprompt(WS.vault.door.robPrompt.ProximityPrompt)
            task.wait(2)

            local Number = char.DuffelBag.display.SurfaceGui.Frame.TextLabel.Text
            Number = Number:gsub("0/", "")

            for _ = 1, tonumber(Number) do
                local Cash = WS.BankItems.Cash:FindFirstChild("Cash")
                if not Cash then
                    for _, v in WS:GetChildren() do
                        if v.Name == "Cash" and v:IsA("Model") and v:FindFirstChild("Model") then Cash = v end
                    end
                end
                BypassTeleport(Cash.Model.Cash.CFrame)
                task.wait(0.4)
                fireproximityprompt(Cash.Model:FindFirstChildWhichIsA("ProximityPrompt", true))
                task.wait(0.3)
            end

            BypassTeleport(WS.sellgold.CFrame)
            task.wait(0.1)
            fireclickdetector(WS.sellgold.ClickDetector)
            pcall(BypassTeleport, OldCFrame)
        end
    end)

 

    task.spawn(function()
        while true do
            task.wait()
            if not Farms.FarmHouses then continue end

            local char = LP.Character
            local hum  = char and char:FindFirstChild("Humanoid")
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if not (char and hum and hrp and hum.Health > 0) then continue end

            local OldCFrame      = hrp.CFrame
            local HardDoorPrompt = WS.HouseRobb.HardDoor.Door:FindFirstChildWhichIsA("ProximityPrompt", true)

            if not HardDoorPrompt or not HardDoorPrompt.Enabled then
                if Farms.AFKCheck then pcall(BypassTeleport, OldCFrame) end
                continue
            end

            repeat
                task.wait()
                BypassTeleport(HardDoorPrompt.Parent.CFrame)
                task.wait(0.1)
                fireproximityprompt(HardDoorPrompt)
            until WS.HouseRobb.HardDoor:FindFirstChild("TakeMoney")
                and WS.HouseRobb.HardDoor.TakeMoney:FindFirstChild("MoneyGrab")
                and WS.HouseRobb.HardDoor.TakeMoney.MoneyGrab:FindFirstChildWhichIsA("ProximityPrompt", true).Enabled

            for _, Value in WS.HouseRobb.HardDoor.TakeMoney:GetChildren() do
                BypassTeleport(Value.CFrame)
                fireproximityprompt(Value.ProximityPrompt)
                task.wait()
            end

            task.wait(0.2)
            pcall(BypassTeleport, OldCFrame)
        end
    end)

    

    getgenv().TrashItems = getgenv().TrashItems or {
        "Bag","Screwdriver","C FnBody1","C G26Body1","C UziBase1",
        "C G26Body2","C G22Body2","C G22Body1","C AxeBody1",
        "Cleaver","C UziStock3","Card","C AxeBody2",
        "C UziStock2","C FNBody2",
    }

    task.spawn(function()
        while true do
            task.wait()
            if not Farms.FarmTrash then continue end

            local char = LP.Character
            local hum  = char and char:FindFirstChild("Humanoid")
            if not (char and hum and hum.Health > 0 and char:FindFirstChild("HumanoidRootPart")) then continue end

            for _, v in pairs(WS:GetChildren()) do
                if v.Name == "DumpsterPromt" then
                    local p = v:FindFirstChild("ProximityPrompt")
                    if p and p.Enabled then
                        p.HoldDuration = 0
                        BypassTeleport(v.CFrame + Vector3.new(0, 3, 0))
                        task.wait(0.3)
                        fireproximityprompt(p)
                        task.wait(0.3)
                        p.HoldDuration = 1
                    end
                end
            end

            if Farms.AutoSellTrash then
                local gui = LP:FindFirstChild("PlayerGui")
                if gui and gui:FindFirstChild("Bronx PAWNING") then
                    local list = gui["Bronx PAWNING"].Frame.Holder.List
                    for _, frame in ipairs(list:GetChildren()) do
                        if not Farms.FarmTrash then break end
                        if frame:IsA("Frame") and frame:FindFirstChild("Item") then
                            local itemName = frame.Item.Text
                            if table.find(getgenv().TrashItems, itemName) then
                                while Farms.FarmTrash and LP.Backpack:FindFirstChild(itemName) do
                                    RS.PawnRemote:FireServer(itemName)
                                    task.wait(0.3)
                                end
                            end
                        end
                    end
                end
                for _, tool in pairs(LP.Backpack:GetChildren()) do
                    if tool:IsA("Tool") then
                        RS:WaitForChild("PawnRemote"):FireServer(tool.Name)
                        task.wait()
                    end
                end
                task.wait(1)
            end
        end
    end)
end
-- ============================
--          AIM TAB
-- ============================

do
    local LP     = S.LocalPlayer
    local RunSvc = S.RunService
    local Camera = S.Workspace.CurrentCamera
    local Mouse  = LP:GetMouse()
    local RS     = S.ReplicatedStorage

    local aimMultiSection = Tabs.Aim:MultiSection({
        Title     = "Hitbox & Aimbot",
        Desc      = "enjoy these features!",
        Icon      = "crosshair",
        Opened    = true,
        Box       = true,
        BoxBorder = true,
    })

    local HitboxTab = aimMultiSection:Tab({ Title = "Hitbox",       Icon = "box",       Selected = true  })
    local SilentTab = aimMultiSection:Tab({ Title = "Silent / Gun", Icon = "crosshair", Selected = false })


    --       HITBOX EXPANDER
 

    getgenv().HitboxEnabled      = false
    getgenv().HitboxSize         = 10
    getgenv().HitboxPart         = "Head"
    getgenv().HitboxTransparency = 0.3

    local heartbeatConnection = nil

    local function ApplyHitbox(player)
        if not player.Character then return end
        local part = player.Character:FindFirstChild(getgenv().HitboxPart)
        if not part or not part:IsA("BasePart") then return end
        if part:FindFirstChild("HitboxExpanded") then return end

        local origSize        = Instance.new("Vector3Value")
        origSize.Name         = "OriginalSize"
        origSize.Value        = part.Size
        origSize.Parent       = part

        local origTrans       = Instance.new("NumberValue")
        origTrans.Name        = "OriginalTransparency"
        origTrans.Value       = part.Transparency
        origTrans.Parent      = part

        part.Size         = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
        part.Transparency = getgenv().HitboxTransparency
        part.CanCollide   = false
        part.Massless     = true

        local marker      = Instance.new("BoolValue")
        marker.Name       = "HitboxExpanded"
        marker.Value      = true
        marker.Parent     = part
    end

    local function RevertHitbox(player)
        if not player.Character then return end
        local part = player.Character:FindFirstChild(getgenv().HitboxPart)
        if not part or not part:IsA("BasePart") then return end
        local marker = part:FindFirstChild("HitboxExpanded")
        if not marker then return end
        local origSize  = part:FindFirstChild("OriginalSize")
        local origTrans = part:FindFirstChild("OriginalTransparency")
        if origSize  then part.Size         = origSize.Value;  origSize:Destroy()  end
        if origTrans then part.Transparency = origTrans.Value; origTrans:Destroy() end
        part.Massless = false
        marker:Destroy()
    end

    local function UpdateAllHitboxes()
        for _, player in S.Players:GetPlayers() do
            if player ~= LP then
                if getgenv().HitboxEnabled then ApplyHitbox(player)
                else                             RevertHitbox(player) end
            end
        end
    end

    local function StartHitboxLoop()
        if heartbeatConnection then heartbeatConnection:Disconnect() end
        heartbeatConnection = RunSvc.Heartbeat:Connect(function()
            if not getgenv().HitboxEnabled then return end
            UpdateAllHitboxes()
        end)
    end

    local function StopHitboxLoop()
        if heartbeatConnection then heartbeatConnection:Disconnect(); heartbeatConnection = nil end
        UpdateAllHitboxes()
    end

    S.Players.PlayerAdded:Connect(function(plr)
        plr.CharacterAdded:Connect(function()
            if getgenv().HitboxEnabled then
                task.delay(0.3, function() ApplyHitbox(plr) end)
            end
        end)
    end)

    task.spawn(function()
        task.wait(1.2)
        if getgenv().HitboxEnabled then UpdateAllHitboxes() end
    end)

    -- Hitbox UI

    HitboxTab:Toggle({
        Title    = "Enable Hitbox Expander",
        Icon     = "box",
        Value    = false,
        Callback = function(enabled)
            getgenv().HitboxEnabled = enabled
            if enabled then StartHitboxLoop(); UpdateAllHitboxes()
            else             StopHitboxLoop() end
        end,
    })

    HitboxTab:Slider({
        Title    = "Hitbox Size",
        Icon     = "ruler",
        Min      = 5,
        Max      = 50,
        Default  = 10,
        Suffix   = " studs",
        Callback = function(value)
            getgenv().HitboxSize = value
            if getgenv().HitboxEnabled then StopHitboxLoop(); StartHitboxLoop() end
        end,
    })

    HitboxTab:Dropdown({
        Title    = "Target Part",
        Icon     = "person-standing",
        Values   = { "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart", "LeftUpperLeg", "RightUpperLeg" },
        Value    = "Head",
        Callback = function(value)
            getgenv().HitboxPart = value
            if getgenv().HitboxEnabled then StopHitboxLoop(); StartHitboxLoop() end
        end,
    })

    -- ============================
    --    SILENT AIM + AIMBOT
    -- ============================

    getgenv().SilentAimEnabled    = false
    getgenv().SilentAimHitPart    = "Head"
    getgenv().SilentAimHitChance  = 100
    getgenv().SilentAimFOVEnabled = true
    getgenv().SilentAimFOVRadius  = 150
    getgenv().WallbangEnabled     = false

    local FOVCircle           = Drawing.new("Circle")
    FOVCircle.Color           = Color3.fromRGB(227, 11, 92)
    FOVCircle.Thickness       = 1.5
    FOVCircle.NumSides        = 64
    FOVCircle.Filled          = false
    FOVCircle.Transparency    = 1
    FOVCircle.Visible         = false

    RunSvc.RenderStepped:Connect(function()
        if getgenv().SilentAimEnabled and getgenv().SilentAimFOVEnabled then
            FOVCircle.Visible  = true
            FOVCircle.Position = Vector2.new(Mouse.X, Mouse.Y + 36)
            FOVCircle.Radius   = getgenv().SilentAimFOVRadius
        else
            FOVCircle.Visible = false
        end
    end)

    local function IsPartVisible(targetPart)
        if not getgenv().WallbangEnabled then
            local origin    = Camera.CFrame.Position
            local direction = (targetPart.Position - origin)
            local rayParams = RaycastParams.new()
            rayParams.FilterDescendantsInstances = {LP.Character}
            rayParams.FilterType                 = Enum.RaycastFilterType.Exclude
            rayParams.IgnoreWater                = true
            local result = workspace:Raycast(origin, direction * 2, rayParams)
            return result and result.Instance:IsDescendantOf(targetPart.Parent)
        end
        return true
    end

    local function GetClosestPlayerToMouse()
        if not getgenv().SilentAimEnabled then return nil end
        local closestPlayer = nil
        local shortestDist  = math.huge
        local mousePos      = Vector2.new(Mouse.X, Mouse.Y)
        for _, player in ipairs(S.Players:GetPlayers()) do
            if player ~= LP
            and player.Character
            and player.Character:FindFirstChild("Humanoid")
            and player.Character.Humanoid.Health > 0 then
                local part = player.Character:FindFirstChild(getgenv().SilentAimHitPart)
                if part and IsPartVisible(part) then
                    local screenPos, onScreen = Camera:WorldToScreenPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if getgenv().SilentAimFOVEnabled and dist > getgenv().SilentAimFOVRadius then continue end
                        if dist < shortestDist then
                            shortestDist  = dist
                            closestPlayer = player
                        end
                    end
                end
            end
        end
        return closestPlayer
    end

    local SilentTarget = nil
    task.spawn(function()
        while task.wait(0.1) do
            SilentTarget = GetClosestPlayerToMouse()
        end
    end)

    -- kill_gun
    local kill_gun = function(target, hpart, damage)
        if not hpart  then hpart  = "Head"   end
        if not damage then damage = math.huge end
        local tool   = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
        local tPlr   = S.Players:FindFirstChild(target)
        if not tool or not tPlr or not tPlr.Character then return end
        local tChar  = tPlr.Character
        local tPart  = tChar:FindFirstChild(hpart)
        if not tPart then return end

        pcall(function() require(tool.Setting).Range = 10000 end)

        RS.VisualizeMuzzle:FireServer(table.unpack({
            tool.Handle, true,
            { false, 7, Color3.new(1,1,0), 15, true, 0.02 },
            tool.GunScript_Local.MuzzleEffect
        }))

        RS.VisualizeBullet:FireServer(table.unpack({
            tool, tool.Handle,
            Vector3.new(-0.17746905982494, 0.088731124997139, 0.98011803627014),
            tool.Handle.GunFirePoint,
            { true, {112139677907600,92977228204408,112139677907600,92977228204408}, 1, 1, 10, tool.GunScript_Local.HitEffect, true },
            { true, {0,0,0,0,0,0}, 1, 1, 1, tool.GunScript_Local.BloodEffect },
            { true, 0.2, {3696144972}, true, 7, 1 },
            { false, 8, true, {163064102}, 1, 1.5, 1, false, tool.GunScript_Local.ExplosionEffect },
            { false, Vector3.new(0.1,0,0), Vector3.new(-0.1,0,0), tool.GunScript_Local.TracerEffect, nil, tool.GunScript_Local.ParticleEffect, 300, 526, 0, Vector3.zero, Vector3.new(0.4,0.4,0.4), Color3.new(0.639,0.635,0.611), 1, Enum.Material.Neon, Enum.PartType.Cylinder, false, 6696543809, 0, Vector3.new(0.007,0.007,0.007) },
            { true, {269514869,269514887,269514807,269514817}, 0.5, 1, 1.5, 100 },
            { false, 3, Color3.new(1,0.647,0.6), 6, true }
        }))

        RS.InflictTarget:FireServer(table.unpack({
            tool, LP,
            tChar.Humanoid, tPart, damage,
            { 0, 0, false, false, tool.GunScript_Server.IgniteScript, tool.GunScript_Server.IcifyScript, 100, 100 },
            { false, 5, 3 },
            tPart,
            { false, {1930359546}, 1, 1.5, 1 },
            tPart.Position,
            Vector3.new(0.074456036090851, -0.099775791168213, -0.99222022294998),
            true
        }))
    end

    getgenv().kill_gun = kill_gun

    -- Silent Aim UI

    SilentTab:Toggle({
        Title    = "Enable Silent Aim",
        Icon     = "crosshair",
        Value    = false,
        Callback = function(v)
            getgenv().SilentAimEnabled = v
            getgenv().WallbangEnabled  = v
        end,
    })

    SilentTab:Toggle({
        Title    = "FOV Circle",
        Icon     = "circle",
        Value    = false,
        Callback = function(v) getgenv().SilentAimFOVEnabled = v end,
    })

    SilentTab:Toggle({
        Title    = "Wallbang",
        Icon     = "shield-off",
        Value    = false,
        Callback = function(v) getgenv().WallbangEnabled = v end,
    })

    SilentTab:Slider({
        Title    = "FOV Radius",
        Icon     = "ruler",
        Min      = 50,
        Max      = 500,
        Default  = 150,
        Suffix   = "px",
        Callback = function(v) getgenv().SilentAimFOVRadius = v end,
    })

    SilentTab:Dropdown({
        Title    = "Hit Part",
        Icon     = "person-standing",
        Values   = { "Head", "UpperTorso", "LowerTorso" },
        Value    = "Head",
        Callback = function(v) getgenv().SilentAimHitPart = v end,
    })

    SilentTab:Slider({
        Title    = "Hit Chance",
        Icon     = "percent",
        Min      = 0,
        Max      = 100,
        Default  = 100,
        Suffix   = "%",
        Callback = function(v) getgenv().SilentAimHitChance = v end,
    })

    SilentTab:Divider()

    -- Aimbot

    local aimbotEnabled = false
    local aimbotPart    = "Head"
    local aimbotDelay   = 0.05

    SilentTab:Toggle({
        Title    = "Enable Aimbot",
        Icon     = "target",
        Desc     = "Auto-fires at closest player in FOV. Hold a gun.",
        Value    = false,
        Callback = function(v)
            aimbotEnabled = v
            WindUI:Notify({ Title = v and "Aimbot On" or "Aimbot Off", Icon = "target", Duration = 3 })
        end,
    })

    SilentTab:Dropdown({
        Title    = "Aimbot Hit Part",
        Icon     = "person-standing",
        Values   = { "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart" },
        Value    = "Head",
        Callback = function(v) aimbotPart = v end,
    })

    SilentTab:Slider({
        Title    = "Fire Delay",
        Icon     = "timer",
        Min      = 1,
        Max      = 30,
        Default  = 5,
        Suffix   = "0ms",
        Callback = function(v) aimbotDelay = v * 0.01 end,
    })

    task.spawn(function()
        while true do
            task.wait(aimbotDelay)
            if not aimbotEnabled then continue end
            local char = LP.Character
            if not char or not char:FindFirstChildOfClass("Tool") then continue end
            local target = SilentTarget
            if not target or not target.Character then continue end
            local hum = target.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            if math.random(1, 100) <= getgenv().SilentAimHitChance then
                pcall(kill_gun, target.Name, aimbotPart, math.huge)
            end
        end
    end)
end
