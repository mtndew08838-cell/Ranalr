})

Tabs.EspTab:Toggle({
    Title    = "Show Healthbar",
    Value    = false,
    Callback = function(v) Config.ESP.Drawing.Healthbar.Enabled = v end,
})

Tabs.EspTab:Toggle({
    Title    = "Health Text",
