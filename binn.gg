-- MB reactive logo — find the icon ImageLabel in the window and overlay a pulsing TextLabel
task.defer(function()
    local RunSvc2 = game:GetService("RunService")

    -- hunt for the logo image in the GUI tree
    local function findLogo(root)
        for _, v in ipairs(root:GetDescendants()) do
            if v:IsA("ImageLabel") and v.Image == "rbxassetid://119335616968310" then
                return v
            end
        end
    end

    local gui = game:GetService("CoreGui")
    local logoImg

    -- retry a few frames — UI may not exist yet
    for _ = 1, 30 do
        logoImg = findLogo(gui)
        if logoImg then break end
        task.wait(0.05)
    end

    if not logoImg then return end

    -- hide the original icon image
    logoImg.ImageTransparency = 1

    -- build the MB text on top
    local mbLabel = Instance.new("TextLabel")
    mbLabel.Size                 = UDim2.fromScale(1, 1)
    mbLabel.BackgroundTransparency = 1
    mbLabel.TextScaled           = true
    mbLabel.Font                 = Enum.Font.GothamBold
    mbLabel.Text                 = "MB"
    mbLabel.ZIndex               = logoImg.ZIndex + 1
    mbLabel.Parent               = logoImg

    -- blue-to-blue smooth reactive pulse
    -- cycles between two blues with a sine wave so it breathes rather than flicks
    local mbT = 0
    local BLUE_A = Color3.fromHex("#0c0c0c")   -- light cyan-blue
    local BLUE_B = Color3.fromHex("#0040ff")   -- deep electric blue

    RunSvc2.RenderStepped:Connect(function(dt)
        mbT += dt * 1.4
        local alpha = (math.sin(mbT) + 1) / 2   -- 0→1, smooth sinusoidal
        mbLabel.TextColor3 = BLUE_A:Lerp(BLUE_B, alpha)
    end)
end)


