    Icon     = "map-pin",
    Callback = function()
        if not S.LocalPlayer.Character then
            WindUI:Notify({ Title = "No Character", Content = "Respawn and try again.", Icon = "alert-triangle", Duration = 3 })
            return
        end
        for _, entry in ipairs(TeleportationList) do
            if entry.Name == SelectedTeleport then
                BypassTeleport(entry.CF)
                WindUI:Notify({ Title = "Teleported", Content = "Moved to " .. entry.Name, Icon = "map-pin", Duration = 3 })
                return
            end
        end
    end,
})

Tabs.TelTab:Divider()

local TpSvc   = game:GetService("TeleportService")
local HttpSvc = game:GetService("HttpService")
local PID     = game.PlaceId
local TelPlr  = S.LocalPlayer

Tabs.TelTab:Button({
    Title    = "Rejoin",
    Icon     = "refresh-cw",
    Callback = function()
        TpSvc:Teleport(PID, TelPlr)
    end,
})

Tabs.TelTab:Button({
    Title    = "Join Lowest Server",
    Icon     = "arrow-down",
    Callback = function()
        local servers, cursor = {}, ""
        repeat
            local url  = "https://games.roblox.com/v1/games/" .. PID ..
                "/servers/Public?sortOrder=Asc&limit=100" ..
                (cursor ~= "" and "&cursor=" .. cursor or "")
            local data = HttpSvc:JSONDecode(game:HttpGet(url))
            for _, sv in ipairs(data.data) do
                if sv.playing < sv.maxPlayers then table.insert(servers, sv) end
            end
            cursor = data.nextPageCursor
        until not cursor or #servers > 0
        table.sort(servers, function(a, b) return a.playing < b.playing end)
        if servers[1] then
            TpSvc:TeleportToPlaceInstance(PID, servers[1].id, TelPlr)
        else
            WindUI:Notify({ Title = "No servers found", Icon = "alert-triangle", Duration = 3 })
        end
    end,
})

