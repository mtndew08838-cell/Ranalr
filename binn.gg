-- ============================
--      TELEPORT BYPASS
-- ============================

local _humanoidRootPart = nil

local function _updateHRP()
    local char = S.LocalPlayer.Character
    if char then
        _humanoidRootPart = char:FindFirstChild("HumanoidRootPart")
    end
end

S.LocalPlayer.CharacterAdded:Connect(function(char)
    _humanoidRootPart = char:WaitForChild("HumanoidRootPart")
end)
_updateHRP()

local function BypassTeleport(CF)
    local player = S.LocalPlayer
    if not player.Character then return end
    _updateHRP()
    if not _humanoidRootPart then return end
    local humanoid = _humanoidRootPart.Parent:FindFirstChild("Humanoid")
    if not humanoid then return end

    getgenv().SwimMethod = true
    humanoid:ChangeState(0)

    local t0 = tick()
    while player:GetAttribute("LastACPos") and (tick() - t0) < 2 do
        task.wait(0.0001)
    end

    _humanoidRootPart.CFrame = CF
    task.wait(0.1)
    humanoid:ChangeState(2)
    getgenv().SwimMethod = false
end

-- ============================
--     INFINITE MONEY HELPERS
-- ============================

local function GetFruitCup()
    local Found, Cup = false, nil
    for _, Value in ipairs(S.LocalPlayer.Backpack:GetChildren()) do
        if Value:IsA("Tool") and Value.Name == "Ice-Fruit Cupz" then
            if Value["IceFruit Cup"]["IceFruit PunchMedium"].Transparency ~= 1 then
                Found = true; Cup = Value; break
            end
        end
    end
    if not Found then
        for _, Value in ipairs(S.LocalPlayer.Character:GetChildren()) do
            if Value:IsA("Tool") and Value.Name == "Ice-Fruit Cupz" then
                if Value["IceFruit Cup"]["IceFruit PunchMedium"].Transparency ~= 1 then
                    Found = true; Cup = Value; break
                end
            end
        end
    end
    return Found, Cup
end

local function GetGoodCleaner()
    local CounterInstance
    for _, Value in ipairs(S.Workspace["1# Map"]:GetChildren()) do
        if Value:FindFirstChild("CounterM") then CounterInstance = Value end
    end
    if not CounterInstance then return nil end
    for _, batch in next, {S.Workspace.CounterBag:GetChildren(), CounterInstance:GetChildren()} do
        for _, v in batch do
            local cashPrompt = v:FindFirstChild("CashPrompt", true)
            local grabPrompt = v:FindFirstChild("GrabPrompt", true)
            if cashPrompt and cashPrompt.Enabled and cashPrompt.ObjectText == "Count Bread"
            and grabPrompt and not grabPrompt.Enabled then
                return v
            end
        end
    end
end

local function CleanDirtyMoney()
    if S.LocalPlayer.stored.FilthyStack.Value == 0 then return end
    if not S.LocalPlayer.Character or not S.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    if not S.LocalPlayer.Character:FindFirstChild("Humanoid") or S.LocalPlayer.Character.Humanoid.Health == 0 then return end

    local Cleaner = GetGoodCleaner()
    if not Cleaner then return end

    BypassTeleport(Cleaner.WorldPivot)
    task.wait(0.4)
    fireproximityprompt(Cleaner:FindFirstChild("CashPrompt", true))

    repeat task.wait() until Cleaner:FindFirstChild("On", true).Color == Color3.fromRGB(74, 156, 69)
    task.wait(0.5)

    fireproximityprompt(Cleaner:FindFirstChild("CashPrompt", true))
    task.wait(0.25)
    BypassTeleport(Cleaner.WorldPivot)
    task.wait(0.4)

    repeat task.wait() until S.LocalPlayer.Backpack:FindFirstChild("MoneyReady")
    S.LocalPlayer.Character.Humanoid:EquipTool(S.LocalPlayer.Backpack["MoneyReady"])

    repeat task.wait(0.1)
        fireproximityprompt(Cleaner:FindFirstChild("GrabPrompt", true))
    until not S.LocalPlayer.Character:FindFirstChild("MoneyReady")

    repeat task.wait() until S.LocalPlayer.Backpack:FindFirstChild("BagOfMoney")

    BypassTeleport(CFrame.new(-203, 284, -1201))
    task.wait(0.4)
    S.LocalPlayer.Character.Humanoid:EquipTool(S.LocalPlayer.Backpack["BagOfMoney"])
    task.wait(1)
    fireproximityprompt(S.Workspace.ATMMoney.Prompt)
    WindUI:Notify({ Title = "Done!", Content = "Dirty money cleaned.", Icon = "coins", Duration = 3 })
end

local function InfiniteMoney_Auto()
    local Found, Cup = GetFruitCup()
    local OLDCFrame  = S.LocalPlayer.Character.HumanoidRootPart.CFrame
    local StarterGui = game:GetService("StarterGui")

    -- Fast path: already have a filled cup, sell it immediately then clean
    if Found and Cup then
        if Cup.Parent == S.LocalPlayer.Backpack then
            S.LocalPlayer.Character.Humanoid:EquipTool(Cup)
            task.wait(1)
        end

        BypassTeleport(S.Workspace["IceFruit Sell"].CFrame)
        task.wait(0.5)

        local prompt = S.Workspace["IceFruit Sell"].ProximityPrompt
        local origHold, origDist = prompt.HoldDuration, prompt.MaxActivationDistance
        prompt.HoldDuration          = 0
        prompt.MaxActivationDistance = 50
        prompt.RequiresLineOfSight   = false
        S.LocalPlayer.Character.HumanoidRootPart.Anchored = true
        for i = 1, 1000 do fireproximityprompt(prompt, 0) end
        prompt.HoldDuration          = origHold
        prompt.MaxActivationDistance = origDist
        S.LocalPlayer.Character.HumanoidRootPart.Anchored = false
        BypassTeleport(OLDCFrame)
        WindUI:Notify({ Title = "Sold!", Content = "Cup sold — cleaning dirty money now.", Icon = "banknote", Duration = 3 })
        CleanDirtyMoney()
        return
    end

    -- Full path: buy ingredients, cook, sell, then clean
    WindUI:Notify({ Title = "No Filled Cup", Content = "Buying ingredients — need ~$5k.", Icon = "alert-triangle", Duration = 3 })

    local Itemz = { "FijiWater", "FreshWater", "Ice-Fruit Bag", "Ice-Fruit Cupz" }
    local Stove

    for _, Value in S.Workspace.CookingPots:GetChildren() do
        if Value:IsA("Model") then
            local pp = Value:FindFirstChildWhichIsA("ProximityPrompt", true)
            if pp and pp.ActionText == "Turn On" and pp.Enabled then
                Stove = Value; break
            end
        end
    end

    if not Stove then
        WindUI:Notify({ Title = "No Stove Found", Content = "No available cooking pot.", Icon = "alert-triangle", Duration = 3 })
        return
    end

    for _, Value in ipairs(Itemz) do
        if not S.LocalPlayer.Backpack:FindFirstChild(Value) then
            S.ReplicatedStorage:WaitForChild("ExoticShopRemote"):InvokeServer(Value)
            task.wait(1)
        end
    end
    for _, Value in ipairs(Itemz) do
        if not S.LocalPlayer.Backpack:FindFirstChild(Value) then
            WindUI:Notify({ Title = "Missing Items", Content = "Need at least $5000.", Icon = "alert-triangle", Duration = 3 })
            return
        end
    end

    BypassTeleport(Stove.CookPart.CFrame)
    task.wait(1)
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
    S.LocalPlayer.Character.HumanoidRootPart.Anchored = true
    task.wait(1.5)
    fireproximityprompt(Stove:FindFirstChildWhichIsA("ProximityPrompt", true))
    task.wait(2)

    for _, Value in ipairs({ "FijiWater", "FreshWater", "Ice-Fruit Bag" }) do
        S.LocalPlayer.Character.Humanoid:EquipTool(S.LocalPlayer.Backpack[Value])
        task.wait(1)
        fireproximityprompt(Stove:FindFirstChildWhichIsA("ProximityPrompt", true))
        task.wait(3)
    end

    repeat task.wait() until Stove.CookPart.Steam.LoadUI.Enabled == false

    if not S.LocalPlayer.Character:FindFirstChild("Ice-Fruit Cupz") then
        S.LocalPlayer.Character.Humanoid:EquipTool(S.LocalPlayer.Backpack["Ice-Fruit Cupz"])
        task.wait(1)
    end
    task.wait(1)
    fireproximityprompt(Stove:FindFirstChildWhichIsA("ProximityPrompt", true))
    task.wait(3)

    S.LocalPlayer.Character.HumanoidRootPart.Anchored = false
    BypassTeleport(S.Workspace["IceFruit Sell"].CFrame)
    task.wait(1)
    S.LocalPlayer.Character.HumanoidRootPart.Anchored = true
    task.wait(1.5)

    if not S.LocalPlayer.Character:FindFirstChild("Ice-Fruit Cupz") then
        S.LocalPlayer.Character.Humanoid:EquipTool(S.LocalPlayer.Backpack["Ice-Fruit Cupz"])
        task.wait(1)
    end

    local prompt = S.Workspace["IceFruit Sell"].ProximityPrompt
    local origHold, origDist = prompt.HoldDuration, prompt.MaxActivationDistance
    prompt.HoldDuration          = 0
    prompt.MaxActivationDistance = 50
    prompt.RequiresLineOfSight   = false
    for i = 1, 1000 do fireproximityprompt(prompt, 0) end
    prompt.HoldDuration          = origHold
    prompt.MaxActivationDistance = origDist
    S.LocalPlayer.Character.HumanoidRootPart.Anchored = false
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
    task.wait(0.5)
    BypassTeleport(OLDCFrame)
    WindUI:Notify({ Title = "Sold!", Content = "Cup cooked and sold — cleaning dirty money now.", Icon = "banknote", Duration = 3 })
    CleanDirtyMoney()
end

local function InfiniteMoney_Manual()
    local char = S.LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local Cup = nil
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") and v.Name == "Ice-Fruit Cupz" then Cup = v; break end
    end
    if not Cup then
        for _, v in ipairs(S.LocalPlayer.Backpack:GetChildren()) do
            if v:IsA("Tool") and v.Name == "Ice-Fruit Cupz" then Cup = v; break end
        end
    end

    if not Cup then
        WindUI:Notify({ Title = "No Cup", Content = "Equip a filled Ice-Fruit Cupz first.", Icon = "alert-triangle", Duration = 3 })
        return
    end

    if Cup.Parent == S.LocalPlayer.Backpack then
        char.Humanoid:EquipTool(Cup)
        task.wait(0.5)
    end

    local OldCFrame = hrp.CFrame
    BypassTeleport(S.Workspace["IceFruit Sell"].CFrame)
    task.wait(0.5)

    local prompt = S.Workspace["IceFruit Sell"].ProximityPrompt
    local origHold, origDist = prompt.HoldDuration, prompt.MaxActivationDistance
    prompt.HoldDuration          = 0
    prompt.MaxActivationDistance = 50
    prompt.RequiresLineOfSight   = false
    S.LocalPlayer.Character.HumanoidRootPart.Anchored = true
    for i = 1, 1000 do fireproximityprompt(prompt, 0) end
    prompt.HoldDuration          = origHold
    prompt.MaxActivationDistance = origDist
    S.LocalPlayer.Character.HumanoidRootPart.Anchored = false
    task.wait(0.5)
    BypassTeleport(OldCFrame)
    WindUI:Notify({ Title = "Sold!", Content = "Cup sold — cleaning dirty money now.", Icon = "coins", Duration = 3 })
    CleanDirtyMoney()
end

-- ============================
--       AUTO DUPE TAB UI
-- ============================

do
    local dupeCooldown   = false
    local autoDupeActive = false

    local function _enableSwim()
        getgenv().SwimMethod = true
        task.wait(1)
    end

    local function _disableSwim()
        getgenv().SwimMethod = false
    end

    local function _dupeBypassTp(player, cf)
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        _enableSwim()
        task.wait(0.25)
        char.HumanoidRootPart.CFrame = cf + Vector3.new(2, 0, 0)
        task.delay(0.25, _disableSwim)
    end

    local function _getSafe()
        local safe = nil
        pcall(function()
            safe = workspace
                :WaitForChild("HomeDoorSS")
                :WaitForChild("HomeDoor")
                :WaitForChild("Safe")
        end)
        return safe
    end

    local function _safeDupeOnce(player, toolName)
        local RS        = game:GetService("ReplicatedStorage")
        local Character = player.Character
        if not Character or not toolName then return end

        local InventoryRemote = RS:WaitForChild("Inventory")
        local BackpackRemote  = RS:WaitForChild("BackpackRemote")
        local Safe = _getSafe()
        if not Safe then return end

        Character.Humanoid:UnequipTools()

        task.spawn(function()
            BackpackRemote:InvokeServer("Store", toolName)
        end)
        task.spawn(function()
            InventoryRemote:FireServer("Change", toolName, "Backpack", Safe)
        end)

        task.wait(2)
        BackpackRemote:InvokeServer("Grab", toolName)

        if not getgenv().StoreDuped then
            InventoryRemote:FireServer("Change", toolName, "Inv", Safe)
        end
    end

    local function _runDupe(player, looping)
        local char = player.Character or player.CharacterAdded:Wait()
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then
            WindUI:Notify({ Title = "No Tool Equipped", Content = "Equip a gun first.", Icon = "alert-triangle", Duration = 4 })
            return false
        end

        local toolName = tool.Name
        local Safe = _getSafe()
        if not Safe then
            WindUI:Notify({ Title = "Safe Not Found", Content = "Make sure you have a safe placed.", Icon = "alert-triangle", Duration = 4 })
            return false
        end

        local safePart
        for _, v in pairs(Safe:GetChildren()) do
            if v:IsA("BasePart") then safePart = v; break end
        end
        if not safePart then
            WindUI:Notify({ Title = "Safe Part Missing", Icon = "alert-triangle", Duration = 4 })
            return false
        end

        if looping then
            WindUI:Notify({ Title = "Duping: " .. toolName, Content = "Safe dupe loop running.", Icon = "infinity", Duration = 4 })
        end

        getgenv().StoreDuped = true

        local originalCFrame = char:WaitForChild("HumanoidRootPart").CFrame

        _dupeBypassTp(player, safePart.CFrame + Vector3.new(0, 0.5, 0))
        task.wait(1)
        _safeDupeOnce(player, toolName)
        task.wait(1)
        _dupeBypassTp(player, originalCFrame)
        task.wait(0.5)

        local backpackTool = player.Backpack:FindFirstChild(toolName)
        if backpackTool then
            player.Character.Humanoid:EquipTool(backpackTool)
        end

        return true
    end

    autoDupeTab:Paragraph({
        Title = "How to use",
        Desc  = "Equip the gun you want to dupe, stand near your safe, then toggle Auto or hit Run Once. Might take a few attempts.",
        Image = "info",
    })

    autoDupeTab:Toggle({
        Title    = "Auto Safe Dupe",
        Icon     = "infinity",
        Desc     = "Loops dupe on your equipped tool automatically.",
        Value    = false,
        Callback = function(state)
            autoDupeActive = state

            task.spawn(function()
                local player = S.LocalPlayer

                while autoDupeActive do
                    if dupeCooldown then task.wait(0.1); continue end
                    dupeCooldown = true

                    local ok = _runDupe(player, true)
                    if not ok then
                        dupeCooldown = false
                        break
                    end

                    WindUI:Notify({ Title = "Dupe Cycle Done", Content = "Looping again in 3s.", Icon = "check", Duration = 3 })
                    dupeCooldown = false
                    task.wait(3)
                end

                if not autoDupeActive then
                    WindUI:Notify({ Title = "Auto Dupe Stopped", Icon = "x", Duration = 3 })
                end
            end)
        end,
    })

    autoDupeTab:Button({
        Title    = "Run Dupe Once",
        Icon     = "play",
        Desc     = "Single dupe pass on your currently equipped tool.",
        Callback = function()
            task.spawn(function()
                if dupeCooldown then
                    WindUI:Notify({ Title = "On Cooldown", Content = "Wait for current cycle to finish.", Icon = "clock", Duration = 3 })
                    return
                end

                dupeCooldown = true
                local player = S.LocalPlayer
                _runDupe(player, false)
                WindUI:Notify({ Title = "Dupe Finished", Icon = "check", Duration = 3 })
                dupeCooldown = false
            end)
        end,
    })
end

