    -- Picks the first HTTP function the executor offers that actually works.
    local requestFn, ready, probing = nil, false, false
    local function probe(fn)
        if type(fn) ~= "function" then
            return false
        end
        local ok, res = pcall(fn, { Url = Library.ChatConfig.Firebase .. "/ping.json", Method = "GET" })
        if ok and type(res) == "table" then
            local sc = tonumber(res.StatusCode or res.status_code or 0) or 0
            local body = tostring(res.Body or res.body or "")
            return sc > 0 or #body > 0
        end
        return false
    end

    function Library._chatRequest(opts)
        if not ready then
            if probing then
                while not ready do
                    task.wait(0.1)
                end
            else
                probing = true
                local getters = {
                    function() return request end,
                    function() return syn and syn.request end,
                    function() return http_request end,
                    function() return http and http.request end,
                    function() return fluxus and fluxus.request end,
                }
                for _, getter in ipairs(getters) do
                    local ok, fn = pcall(getter)
                    if ok and probe(fn) then
                        requestFn = fn
                        break
                    end
                end
                ready = true
            end
        end
        if requestFn then
            local ok, r = pcall(requestFn, opts)
            if ok and type(r) == "table" then
                local sc = tonumber(r.StatusCode or r.status_code) or 200
                return { Success = (sc >= 200 and sc < 300), StatusCode = sc, Body = tostring(r.Body or r.body or "") }
            end
        end
        local ok2, r2 = pcall(function()
            if opts.Method == "GET" then
                return HttpService:GetAsync(opts.Url)
            end
            return HttpService:PostAsync(opts.Url, opts.Body or "", Enum.HttpContentType.ApplicationJson)
        end)
        if ok2 and r2 then
            return { Success = true, StatusCode = 200, Body = tostring(r2) }
        end
        return nil
    end
end

