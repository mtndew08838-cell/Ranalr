    local function addMessage(msg, live)
        local isLocal = msg.a == LocalPlayer.Name
        local name = msg.a
        local isDiscord = msg.isDiscord or name:find("^%[Discord%]") ~= nil
        if isDiscord then
            name = name:gsub("^%[Discord%]%s*", "")
        end

        local wasAtBottom = atBottom()
        local order = math.clamp(math.floor(tonumber(msg.t) or 0), 0, 2147483000)
        local align = isLocal and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left

        local row = create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            LayoutOrder = order,
            Parent = messages,
        })
        create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = align,
            VerticalAlignment = Enum.VerticalAlignment.Top,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
            Parent = row,
        })

        -- avatar
        local avatar = create("ImageLabel", {
            Size = UDim2.fromOffset(30, 30),
            BackgroundColor3 = isDiscord and DISCORD_BLUE or Theme.Surface3,
            ScaleType = Enum.ScaleType.Crop,
            LayoutOrder = isLocal and 2 or 1,
            Parent = row,
        })
        corner(avatar, UDim.new(1, 0))
        if isDiscord then
            local glyph = create("ImageLabel", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(16, 16),
                BackgroundTransparency = 1,
                ImageColor3 = Color3.new(1, 1, 1),
                ScaleType = Enum.ScaleType.Fit,
                Parent = avatar,
            })
            Library._loadDiscordIcon(glyph)
        else
            local initial = label({
                Size = UDim2.fromScale(1, 1),
                Text = string.upper(string.sub(name, 1, 1)),
                TextSize = 13,
                FontFace = Fonts.Bold,
                TextColor3 = Theme.Muted,
                TextXAlignment = Enum.TextXAlignment.Center,
                Parent = avatar,
            })
            resolveAvatar(name, function(image)
                if avatar.Parent then
                    avatar.Image = image
                    initial:Destroy()
                end
            end)
        end

        -- column: name + time, then bubble
        local col = create("Frame", {
            Size = UDim2.fromOffset(0, 0),
