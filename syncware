        end
        return tostring(id or "unknown")
    end

    -- Asks your key server: is this key valid, and has it expired?
    local function checkWithApi(key)
        local url = string.format(
            "%s?key=%s&hwid=%s",
            KeySystem.ApiUrl, HttpService:UrlEncode(key), HttpService:UrlEncode(getHwid())
        )
        local ok, body = pcall(function()
            return game:HttpGet(url)
        end)
        if not ok or type(body) ~= "string" then
            return false, "Could not reach the key server."
        end
        local okJson, data = pcall(function()
            return HttpService:JSONDecode(body)
        end)
        if not okJson or type(data) ~= "table" then
            return false, "Bad response from the key server."
        end
        return data.valid == true, tostring(data.message or (data.valid and "Key accepted." or "Invalid key."))
    end

    local function isValid(key)
        key = cleanKey(key):upper()
        if key == "" then
            return false, "Enter your key first."
        end
        if KeySystem.ApiUrl ~= "" then
            return checkWithApi(key)
        end
        if formatValid(key) then
            return true, "Key accepted."
        end
        for _, known in ipairs(KeySystem.Keys) do
            if cleanKey(known):upper() == key then
                return true, "Key accepted."
            end
        end
        if KeySystem.KeyUrl ~= "" then
            local ok, body = pcall(function()
                return game:HttpGet(KeySystem.KeyUrl)
            end)
            if ok and type(body) == "string" then
                for line in body:gmatch("[^\r\n]+") do
                    if cleanKey(line):upper() == key then
                        return true, "Key accepted."
                    end
                end
            end
        end
        return false, "Invalid key. Try again."
    end

