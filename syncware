    local avatarCache = {}
    local function resolveAvatar(name, apply)
        if avatarCache[name] then
            apply(avatarCache[name])
            return
        end
        task.spawn(function()
            local userId
            if name == LocalPlayer.Name then
                userId = LocalPlayer.UserId
            else
                local ok, id = pcall(function()
                    return Players:GetUserIdFromNameAsync(name)
                end)
                if ok then
                    userId = id
                end
            end
            if userId then
                avatarCache[name] = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=150&h=150"
                apply(avatarCache[name])
            end
        end)
    end

    local function nameColorFor(name)
        local h = 0
        for i = 1, #name do
            h = (h * 31 + string.byte(name, i)) % 360
        end
        return Color3.fromHSV(h / 360, 0.42, 1)
    end

    local function fits(text)
        local len = utf8.len(text)
        return len or #text
    end

    local maxTextW = 300
    local constraints = {}
    local function recomputeWidth()
        local w = messages.AbsoluteSize.X
        if w <= 0 then
            w = 380
        end
        maxTextW = math.max(120, math.floor(w * 0.72) - 28)
        for i = #constraints, 1, -1 do
            local c = constraints[i]
            if c.Parent then
                c.MaxSize = Vector2.new(maxTextW, math.huge)
            else
                table.remove(constraints, i)
            end
        end
    end
    messages:GetPropertyChangedSignal("AbsoluteSize"):Connect(recomputeWidth)
    recomputeWidth()

