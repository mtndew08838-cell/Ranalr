function Group:Toggle(opts)
    opts = normalize(opts, { Title = "Name", Description = "Desc", CurrentValue = "Default", Value = "Default" })
    local row = groupRow(self, "TextButton", opts.Desc and 38 or 24)
    label({
        Size = UDim2.new(1, -30, 0, opts.Desc and 18 or 24),
        Text = opts.Name or "Toggle",
        TextSize = 13,
        Parent = row,
    })
    if opts.Desc then
        label({
            Position = UDim2.fromOffset(0, 19),
            Size = UDim2.new(1, -30, 0, 16),
            Text = opts.Desc,
            TextSize = 12,
            FontFace = Fonts.Regular,
            TextColor3 = Theme.Muted,
            Parent = row,
        })
    end
    local box = create("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, opts.Desc and 1 or 4),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Theme.Surface3,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        Parent = row,
    })
    corner(box, UDim.new(0, 4))
    local boxStroke = stroke(box)

    -- Gradient glow blooms outside the box; gradient fill sits on top of it
    local tickGlow = create("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(36, 36),
        BackgroundTransparency = 1,
        Image = Assets.Glow,
        ImageColor3 = Color3.new(1, 1, 1),
        ImageTransparency = 1,
        ZIndex = 1,
        Parent = box,
    })
    addGradient(tickGlow, 45)
    local boxFill = create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = box,
    })
    corner(boxFill, UDim.new(0, 4))
    addGradient(boxFill, 45)

    local tick = create("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(12, 12),
        BackgroundTransparency = 1,
        ImageColor3 = Theme.Accent,   -- accent-coloured checkmark
        ImageTransparency = 1,
        ZIndex = 3,
        Parent = box,
    })
    applyIcon(tick, "check")

    local self_ = { Value = opts.Default == true }
    local hovering = false
    local function render(animate)
        local duration = animate and 0.15 or 0
        local on = self_.Value

        -- Box: fills with a subtle accent tint when on so the glow sits inside it
        tween(boxFill, { BackgroundTransparency = on and 0 or 1 }, duration)
        tween(boxStroke, {
            Color = on and GRAD_MID or (hovering and Theme.StrokeHover or Theme.Stroke),
        }, duration)

        -- Checkmark: white so it pops over the accent fill
        tween(tick, { ImageTransparency = on and 0 or 1, ImageColor3 = Color3.new(1, 1, 1) }, duration)

        -- Bright glow blooms inside + slightly outside the box
        tween(tickGlow, { ImageTransparency = on and 0.3 or 1 }, duration)
    end
    function self_:Set(value, silent)
        value = value == true
        if value == self_.Value then
            return
        end
        self_.Value = value
        render(true)
        if not silent then
            safeCall(opts.Callback, value)
        end
    end
    function self_:Get()
        return self_.Value
    end
    row.MouseEnter:Connect(function()
        hovering = true
        render(true)
    end)
    row.MouseLeave:Connect(function()
        hovering = false
        render(true)
    end)
    row.MouseButton1Click:Connect(function()
        self_:Set(not self_.Value)
    end)
    render(false)
    indexElement(self, opts.Name or "Toggle", opts.Desc, row)
    local handle = finishElement(self, opts, self_, row, "Toggle")
    if self_.Value then
        safeCall(opts.Callback, true)
    end
    return handle
end
