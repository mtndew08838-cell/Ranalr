local HOME_SAMPLES = 40
local TeleportService = game:GetService("TeleportService")
local StatsService = game:GetService("Stats")

local function rgbString(color)
    return string.format(
        "rgb(%d,%d,%d)",
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5)
    )
end

local function formatDuration(seconds)
    seconds = math.max(math.floor(seconds), 0)
    if seconds < 60 then
        return seconds .. "s"
    end
    if seconds < 3600 then
        return string.format("%dm %02ds", seconds // 60, seconds % 60)
    end
    return string.format("%dh %02dm", seconds // 3600, (seconds % 3600) // 60)
end

local function shortJobId(id)
    if id == "" then
        return "local"
    end
    if #id <= 14 then
        return id
    end
    return id:sub(1, 8) .. ".." .. id:sub(-4)
end

local function readPing()
    local ok, value = pcall(function()
        return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and type(value) == "number" and value > 0 then
        return math.floor(value + 0.5)
    end
    local okFallback, ping = pcall(function()
        return LocalPlayer:GetNetworkPing() * 1000
    end)
    return okFallback and math.floor(ping + 0.5) or 0
end

local function httpGetJson(url)
    local body
    pcall(function()
        body = game:HttpGet(url)
    end)
    if type(body) ~= "string" then
        local requester = request or http_request or (syn and syn.request) or (http and http.request)
        if type(requester) == "function" then
            pcall(function()
                local response = requester({ Url = url, Method = "GET" })
                body = type(response) == "table" and (response.Body or response.body) or nil
            end)
        end
    end
    if type(body) ~= "string" then
        return nil
    end
    local decoded
    local ok = pcall(function()
        decoded = HttpService:JSONDecode(body)
    end)
    return ok and decoded or nil
end

local function pushSample(history, value)
    table.insert(history, value)
    if #history > HOME_SAMPLES then
        table.remove(history, 1)
    end
end

local function summarize(history)
    local count = #history
    if count == 0 then
        return 0, 0, 0
    end
    local lowest, highest, sum = math.huge, 0, 0
    for _, value in ipairs(history) do
        lowest = math.min(lowest, value)
        highest = math.max(highest, value)
        sum += value
    end
    return lowest, math.floor(sum / count + 0.5), highest
end

local function barGraph(parent, position, color)
    local holder = create("Frame", {
        Position = position,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
        Parent = parent,
    })
    local bars = {}
    for index = 1, HOME_SAMPLES do
        bars[index] = create("Frame", {
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new((index - 1) / HOME_SAMPLES, 0, 1, 0),
            Size = UDim2.new(1 / HOME_SAMPLES, -1, 0.06, 0),
            BackgroundColor3 = color,
            BackgroundTransparency = 0.85,
            BorderSizePixel = 0,
            Parent = holder,
        })
    end
    return bars
end

local function renderGraph(bars, history, floorValue)
    local peak = floorValue
    for _, value in ipairs(history) do
        if value > peak then
            peak = value
        end
    end
    local count = #history
    for index = 1, HOME_SAMPLES do
        local sample = history[count - HOME_SAMPLES + index]
        local bar = bars[index]
        if sample then
            bar.Size = UDim2.new(1 / HOME_SAMPLES, -1, math.clamp(sample / peak, 0.06, 1), 0)
            bar.BackgroundTransparency = index == HOME_SAMPLES and 0 or 0.45
        else
            bar.Size = UDim2.new(1 / HOME_SAMPLES, -1, 0.06, 0)
            bar.BackgroundTransparency = 0.85
        end
    end
end

