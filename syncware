local function elementTexts(frame)
    local name, desc
    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("TextLabel") and child.Text ~= "" then
            if not name then
                name = child
            elseif not desc and child.TextSize == 13 and child.TextColor3 == Theme.Muted and child.Position.Y.Offset > name.Position.Y.Offset then
                desc = child
            end
        end
    end
    return name and name.Text, desc and desc.Text
end

