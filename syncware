    local function atBottom()
        return messages.CanvasPosition.Y >= messages.AbsoluteCanvasSize.Y - messages.AbsoluteSize.Y - 60
    end
    local scrollQueued = false
    local function scrollToBottom(animated)
        if scrollQueued then
            return
        end
        scrollQueued = true
        task.defer(function()
            RunService.Heartbeat:Wait()
            scrollQueued = false
            local y = math.max(0, messages.AbsoluteCanvasSize.Y - messages.AbsoluteSize.Y)
            if animated then
                tween(messages, { CanvasPosition = Vector2.new(0, y) }, 0.25)
            else
                messages.CanvasPosition = Vector2.new(0, y)
            end
            jump.Visible = false
        end)
