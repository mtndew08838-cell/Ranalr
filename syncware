	end

	FreezedBlobs[p125] = nil
	pcall(function()
		p125.PrimaryPart:FindFirstChild("AutoFreezeVelocity"):Destroy()
		p125.PrimaryPart:FindFirstChild("AutoFreezeGyro"):Destroy()
	end)
end
