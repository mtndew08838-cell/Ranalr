    -- Ã¢â€â‚¬Ã¢â€â‚¬ Animation state Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
    local sweepAngle  = 0
    local BASE_SPEED  = 150     -- deg/sec
    local SWEEP_SPEED = BASE_SPEED
    local glowBurstT  = 0       -- set to 1 externally (exec tick)
    local strikeT     = 0       -- random lightning flare (also set by the button)
    local nextStrike  = os.clock() + 1.5

    local animConn
    animConn = RunService.Heartbeat:Connect(function(dt)
        if not statsCard.Parent then animConn:Disconnect() return end

        local now = os.clock()
        sweepAngle = (sweepAngle + dt * SWEEP_SPEED) % 360

        if now >= nextStrike then
            strikeT    = 1
            nextStrike = now + 1.6 + math.random() * 2.8
        end
        strikeT    = math.max(0, strikeT - dt * 4.5)
        glowBurstT = math.max(0, glowBurstT - dt * 1.8)

        local energy  = math.clamp(strikeT * 0.8 + glowBurstT, 0, 1)
        local flicker = math.noise(now * 16, 3.7)            -- Ã¢â€°Ë† -0.5 Ã¢â‚¬Â¦ 0.5
        local breathe = 0.5 + 0.5 * math.sin(now * math.pi * 2 / 2.4)
        local jitter  = strikeT > 0.05 and (math.random() - 0.5) * 0.05 * strikeT or 0

        for _, r in ipairs(rings) do
            r.hover = r.hover + (r.hoverTarget - r.hover) * math.min(1, dt * 10)
            r.vis   = r.vis   + (r.visTarget   - r.vis)   * math.min(1, dt * 4)
            local e = math.clamp(energy + r.hover * 0.55, 0, 1)

            local rot = (sweepAngle + r.phase) % 360
            r.ringGrad.Rotation  = rot
            r.bloomGrad.Rotation = rot
            r.ringGrad.Offset    = Vector2.new(jitter, 0)
            r.bloomGrad.Offset   = Vector2.new(jitter, 0)

            r.ringStroke.Thickness  = (1.6 + flicker * 0.5 + e * 1.4) * r.scale
            r.bloomStroke.Thickness = (4.5 + breathe * 1.5 + flicker * 1.2 + e * 5) * r.scale

            local bloomBase = math.clamp(0.55 - breathe * 0.08 - e * 0.35, 0, 1)
            r.ringStroke.Transparency  = 1 - r.vis
            r.bloomStroke.Transparency = 1 - (1 - bloomBase) * r.vis
        end
    end)

