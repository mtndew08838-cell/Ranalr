    -- Ã¢â€â‚¬Ã¢â€â‚¬ shared state Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
    local hue, sat, val = Color3.toHSV(defaultColor)
    local colorOpen   = false
    local dragTarget  = nil
    local toggleSelf  = { Value = opts.Default == true }
    local colorValue  = defaultColor

    local function toHex(c)
        return string.format("#%02X%02X%02X",
            math.floor(c.R * 255 + 0.5),
            math.floor(c.G * 255 + 0.5),
            math.floor(c.B * 255 + 0.5))
    end

    local function renderColor(dur)
        local c = Color3.fromHSV(hue, sat, val)
        colorValue = c
        swatchBtn.BackgroundColor3 = c
        svHueGrad.Color = ColorSequence.new(Color3.new(1,1,1), Color3.fromHSV(hue, 1, 1))
        tween(svCursor,  { Position = UDim2.fromScale(sat, 1 - val) }, dur, Enum.EasingStyle.Linear)
        tween(hueCursor, { Position = UDim2.new(0.5, 0, hue, 0) },    dur, Enum.EasingStyle.Linear)
        if not hexBox:IsFocused() then hexBox.Text = toHex(c) end
        rgbLabel.Text = string.format("rgb %d %d %d",
            math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
    end

    local function commitColor(dur, silent)
        renderColor(dur)
        if not silent then safeCall(opts.ColorCallback, colorValue) end
    end

    local function setColorOpen(open)
        colorOpen = open
        tween(panelWrap, { Size = UDim2.new(1, 0, 0, open and (PANEL_H + 6) or 0) }, 0.28, Enum.EasingStyle.Quint)
        tween(swatchStroke, { Color = open and Theme.StrokeHover or Theme.Stroke }, 0.15)
    end

    -- toggle logic
    local hovering = false
    local function renderToggle(animate)
        local dur = animate and 0.15 or 0
        local on  = toggleSelf.Value
        tween(boxFill,   { BackgroundTransparency = on and 0 or 1 }, dur)
        tween(boxStroke, { Color = on and GRAD_MID or (hovering and Theme.StrokeHover or Theme.Stroke) }, dur)
        tween(tick,      { ImageTransparency = on and 0 or 1, ImageColor3 = Color3.new(1,1,1) }, dur)
        tween(tickGlow,  { ImageTransparency = on and 0.3 or 1 }, dur)
    end

    function toggleSelf:Set(value, silent)
        value = value == true
        if value == self.Value then return end
        self.Value = value
        renderToggle(true)
        if not silent then safeCall(opts.Callback, value) end
    end
    function toggleSelf:Get() return self.Value end

    local colorSelf = {}
    function colorSelf:Set(c, silent)
        hue, sat, val = Color3.toHSV(c)
        commitColor(0.2, silent)
    end
    function colorSelf:Get() return colorValue end

    -- events
    row.MouseEnter:Connect(function() hovering = true;  renderToggle(true) end)
    row.MouseLeave:Connect(function() hovering = false; renderToggle(true) end)
    row.MouseButton1Click:Connect(function()
        toggleSelf:Set(not toggleSelf.Value)
    end)
    swatchBtn.MouseButton1Click:Connect(function()
        setColorOpen(not colorOpen)
    end)

    -- SV drag
    svBox.InputBegan:Connect(function(input)
        if isPress(input) then
            dragTarget = "sv"
            tween(svCursor, { Size = UDim2.fromOffset(12, 12) }, 0.15, Enum.EasingStyle.Back)
            local pos = pointerPosition()
            sat = math.clamp((pos.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
            val = 1 - math.clamp((pos.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
            commitColor(0.04)
        end
    end)
    hueBar.InputBegan:Connect(function(input)
        if isPress(input) then
            dragTarget = "hue"
            local pos = pointerPosition()
            hue = math.clamp((pos.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 0.999)
            commitColor(0.04)
        end
    end)
    self.Window:_listen("Changed", function(input)
        if not dragTarget or not isMove(input) then return end
        local pos = pointerPosition()
        if dragTarget == "sv" then
            sat = math.clamp((pos.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
            val = 1 - math.clamp((pos.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
        else
            hue = math.clamp((pos.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 0.999)
        end
        commitColor(0.04)
    end, toggleSelf)
    self.Window:_listen("Ended", function(input)
        if dragTarget and isPress(input) then
            dragTarget = nil
            tween(svCursor, { Size = UDim2.fromOffset(9, 9) }, 0.18)
        end
    end, toggleSelf)

    hexBox.Focused:Connect(function()  tween(hexStroke, { Color = Theme.StrokeHover }, 0.15) end)
    hexBox.FocusLost:Connect(function()
        tween(hexStroke, { Color = Theme.Stroke }, 0.15)
        local r, g, b = hexBox.Text:match("^%s*#?(%x%x)(%x%x)(%x%x)%s*$")
        if r then
            colorSelf:Set(Color3.fromRGB(tonumber(r,16), tonumber(g,16), tonumber(b,16)))
        else
            hexBox.Text = toHex(colorValue)
        end
    end)

    -- Flags
    if opts.Flag then
        Library.Flags[opts.Flag] = toggleSelf
        toggleSelf._type = "Toggle"
        toggleSelf._frame = wrapper
        toggleSelf._listeners = toggleSelf._listeners or {}
    end
    if opts.ColorFlag then
        Library.Flags[opts.ColorFlag] = colorSelf
        colorSelf._type = "ColorPicker"
        colorSelf._frame = wrapper
        colorSelf._listeners = colorSelf._listeners or {}
    end

    renderToggle(false)
    renderColor(0)
    indexElement(self, opts.Name or "Toggle", opts.Desc, wrapper)

    if toggleSelf.Value then safeCall(opts.Callback, true) end

    -- combined handle returned to caller
    local handle = {
        _type      = "ToggleColor",
        _frame     = wrapper,
        _listeners = {},
        Toggle     = toggleSelf,
        Color      = colorSelf,
        Set        = function(_, v, silent) toggleSelf:Set(v, silent) end,
        Get        = function()             return toggleSelf:Get()   end,
        SetColor   = function(_, c, silent) colorSelf:Set(c, silent)  end,
        GetColor   = function()             return colorSelf:Get()    end,
    }
    function handle:Destroy()
        if self._destroyed then return end
        self._destroyed = true
        for _, d in ipairs(self._listeners) do d() end
        self._listeners = {}
        if opts.Flag     and Library.Flags[opts.Flag]      == toggleSelf then Library.Flags[opts.Flag]      = nil end
        if opts.ColorFlag and Library.Flags[opts.ColorFlag] == colorSelf  then Library.Flags[opts.ColorFlag] = nil end
        wrapper:Destroy()
    end
    return handle
end
Group.CreateToggleColor = Group.ToggleColor

function Group:Slider(opts)
    opts = normalize(opts, { Title = "Name", Description = "Desc", CurrentValue = "Default", Value = "Default", Increment = "Step" })
    local min = opts.Min or 0
    local max = opts.Max or 100
    local step = opts.Step or 1
    local suffix = opts.Suffix or ""
    local numbers = numberFormat(min, max, step)

    local row = groupRow(self, "Frame", opts.Desc and 54 or 38)
    label({
        Size = UDim2.new(1, -110, 0, 18),
        Text = opts.Name or "Slider",
        TextSize = 13,
        Parent = row,
    })
    local valueLabel = label({
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(110, 18),
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = row,
    })
    if opts.Desc then
        label({
            Position = UDim2.fromOffset(0, 18),
            Size = UDim2.new(1, 0, 0, 16),
            Text = opts.Desc,
            TextSize = 12,
            FontFace = Fonts.Regular,
            TextColor3 = Theme.Muted,
            Parent = row,
        })
    end
    local hit = create("TextButton", {
        Position = UDim2.fromOffset(0, opts.Desc and 38 or 22),
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Parent = row,
    })
    local track = create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 0, 8),
        BackgroundColor3 = Theme.Surface3,
        BorderSizePixel = 0,
        Parent = hit,
    })
    corner(track, UDim.new(1, 0))
    local fill = create("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(fill, UDim.new(1, 0))
    addGradient(fill, 0)

    local self_ = { Value = numbers.snap(opts.Default or min) }
    local function render(animate)
        local alpha = max > min and (self_.Value - min) / (max - min) or 0
        tween(fill, { Size = UDim2.fromScale(alpha, 1) }, animate and 0.08 or 0)
        valueLabel.Text = numbers.format(self_.Value) .. suffix
    end
    function self_:Set(value, silent)
        value = numbers.snap(tonumber(value) or min)
        if value == self_.Value then
            return
        end
        self_.Value = value
        render(true)
        if not silent then
            safeCall(opts.Callback, value)
        end
    end
    function self_:Get()
        return self_.Value
    end

    local dragging = false
    local function updateFromX(x)
        local width = math.max(track.AbsoluteSize.X, 1)
        local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        self_:Set(min + (max - min) * alpha)
    end
    hit.InputBegan:Connect(function(input)
        if isPress(input) then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    self.Window:_listen("Changed", function(input)
        if dragging and isMove(input) then
            updateFromX(input.Position.X)
        end
    end, self_)
    self.Window:_listen("Ended", function(input)
        if dragging and isPress(input) then
            dragging = false
        end
    end, self_)

    render(false)
    indexElement(self, opts.Name or "Slider", opts.Desc, row)
    return finishElement(self, opts, self_, row, "Slider")
end

function Group:Dropdown(opts)
    opts = normalize(opts, { Title = "Name", Description = "Desc", CurrentOption = "Default", Value = "Default", MultipleOptions = "Multi", Values = "Options" })
    local multi = opts.Multi == true
    local options = table.clone(opts.Options or {})
    local placeholder = opts.Placeholder or "None"

    local holder = groupStack(self)
    stackHeading(holder, opts, "Dropdown")
    local box, boxStroke = selectBox(holder, 3)
    local valueLabel = label({
        Position = UDim2.fromOffset(10, 0),
        Size = UDim2.new(1, -36, 1, 0),
        TextSize = 13,
        FontFace = Fonts.Regular,
        Parent = box,
    })
    local arrow = create("ImageLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundTransparency = 1,
        ImageColor3 = Theme.Muted,
        Parent = box,
    })
    applyIcon(arrow, "chevron-down")

    local listFrame = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        ClipsDescendants = true,
        Visible = false,
        LayoutOrder = 4,
        Parent = holder,
    })
    corner(listFrame, UDim.new(0, 6))
    stroke(listFrame, Theme.Stroke, 0, 1)
    padding(listFrame, 4, 4, 5, 5)
    create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3), Parent = listFrame })

    local chosen = {}
    if multi then
        for _, value in ipairs(type(opts.Default) == "table" and opts.Default or (opts.Default and { opts.Default } or {})) do
            chosen[value] = true
        end
    elseif opts.Default ~= nil then
        chosen[type(opts.Default) == "table" and opts.Default[1] or opts.Default] = true
    end

    local self_ = { Open = false }
    local optionButtons = {}

    local function currentValue()
        if multi then
            local list = {}
            for _, option in ipairs(options) do
                if chosen[option] then
                    table.insert(list, option)
                end
            end
            return list
        end
        for _, option in ipairs(options) do
            if chosen[option] then
                return option
            end
        end
        return nil
    end
    local function renderValue()
        local value = currentValue()
        local text
        if multi then
            text = #value > 0 and table.concat(value, ", ") or placeholder
        else
            text = value or placeholder
        end
        valueLabel.Text = text
        valueLabel.TextColor3 = text == placeholder and Theme.Muted or Theme.Text
    end
    local function renderOptions()
        for option, entry in pairs(optionButtons) do
            local on = chosen[option] == true
            entry.Label.TextColor3 = on and Theme.Accent or Theme.Text
            entry.Tick.ImageTransparency = on and 0 or 1
            if entry.Box then
                tween(entry.Box, { BackgroundColor3 = on and Theme.Accent or Theme.Surface3 }, 0.12)
                tween(entry.BoxStroke, { Color = on and Theme.Accent or Theme.Stroke }, 0.12)
            end
        end
    end
    local function listHeight()
        return math.min(#options * 34 + 10, 185)
    end
    local function setOpen(open)
        self_.Open = open
        tween(arrow, { Rotation = open and 180 or 0 }, 0.15)
        if open then
            listFrame.Visible = true
            tween(listFrame, { Size = UDim2.new(1, 0, 0, listHeight()) }, 0.18, Enum.EasingStyle.Quint)
        else
            tween(listFrame, { Size = UDim2.new(1, 0, 0, 0) }, 0.15, Enum.EasingStyle.Quint)
            task.delay(0.16, function()
                if not self_.Open then
                    listFrame.Visible = false
                end
            end)
        end
    end

    function self_:Set(value, silent)
        chosen = {}
        if multi then
            for _, entry in ipairs(type(value) == "table" and value or { value }) do
                chosen[entry] = true
            end
        elseif type(value) == "table" then
            chosen[value[1]] = true
        elseif value ~= nil then
            chosen[value] = true
        end
        renderValue()
        renderOptions()
        if not silent then
            safeCall(opts.Callback, currentValue())
        end
    end
    function self_:Get()
        return currentValue()
    end
    function self_:SetOpen(open)
        setOpen(open == true)
    end

    local function buildOptions()
        for _, child in ipairs(listFrame:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end
        optionButtons = {}
        for index, option in ipairs(options) do
            local button = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 34),
                BackgroundColor3 = Theme.Surface2,
                BackgroundTransparency = 0.5,
                Text = "",
                AutoButtonColor = false,
                LayoutOrder = index,
                Parent = listFrame,
            })
            corner(button, UDim.new(0, 6))
            local optionLabel = label({
                Position = UDim2.fromOffset(12, 0),
                Size = UDim2.new(1, -44, 1, 0),
                Text = tostring(option),
                TextSize = 13,
                FontFace = Fonts.Regular,
                Parent = button,
            })
            -- Checkbox box (Image 1 style)
            local optionBox = create("Frame", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.fromOffset(16, 16),
                BackgroundColor3 = Theme.Surface3,
                BorderSizePixel = 0,
                Parent = button,
            })
            corner(optionBox, UDim.new(0, 4))
            local optionBoxStroke = stroke(optionBox)
            local optionTick = create("ImageLabel", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(11, 11),
                BackgroundTransparency = 1,
                ImageColor3 = Color3.new(1, 1, 1),
                ImageTransparency = 1,
                Parent = optionBox,
            })
            applyIcon(optionTick, "check")
            optionButtons[option] = { Label = optionLabel, Tick = optionTick, Box = optionBox, BoxStroke = optionBoxStroke }
            button.MouseEnter:Connect(function()
                tween(button, { BackgroundTransparency = 0.15 }, 0.1)
            end)
            button.MouseLeave:Connect(function()
                tween(button, { BackgroundTransparency = chosen[option] and 0.3 or 0.5 }, 0.15)
            end)
            button.MouseButton1Click:Connect(function()
                if multi then
                    chosen[option] = not chosen[option] or nil
                    renderValue()
                    renderOptions()
                    safeCall(opts.Callback, currentValue())
                else
                    self_:Set(option)
                    setOpen(false)
                end
            end)
        end
        renderOptions()
    end
    function self_:Refresh(newOptions, keepSelection)
        options = table.clone(newOptions or {})
        if not keepSelection then
            chosen = {}
        end
        buildOptions()
        renderValue()
        if self_.Open then
            setOpen(true)
        end
    end

    box.MouseButton1Click:Connect(function()
        setOpen(not self_.Open)
    end)
    buildOptions()
    renderValue()
    indexElement(self, opts.Name or "Dropdown", opts.Desc, holder)
    return finishElement(self, opts, self_, holder, "Dropdown")
end

