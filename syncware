-- live accent recolor: updates Theme.Accent and sweeps every window
function Library:SetAccent(color)
    Library._pendingAccent = color
    if Library._accentBusy then
        return
    end
    Library._accentBusy = true
    task.defer(function()
        Library._accentBusy = false
        local new, old = Library._pendingAccent, Theme.Accent
        if typeof(new) ~= "Color3" or new == old then
            return
        end
        local function near(a)
            return math.abs(a.R - old.R) < 0.004 and math.abs(a.G - old.G) < 0.004 and math.abs(a.B - old.B) < 0.004
        end
        local props = { "BackgroundColor3", "TextColor3", "ImageColor3", "ScrollBarImageColor3" }
        -- lighter tint of the new accent for the start of slider gradients
        local newLight = new:Lerp(Color3.new(1, 1, 1), 0.6)
        for _, window in ipairs(Library.Windows) do
            for _, d in ipairs(window.Gui:GetDescendants()) do
                if d:IsA("UIGradient") then
                    if d:GetAttribute("AccentGradient") then
                        d.Color = ColorSequence.new(newLight, new)
                    end
                elseif d:IsA("UIStroke") then
                    if near(d.Color) then
                        d.Color = new
                    end
                else
                    for _, prop in ipairs(props) do
                        local ok, value = pcall(function()
                            return d[prop]
                        end)
                        if ok and typeof(value) == "Color3" and near(value) then
                            d[prop] = new
                        end
                    end
                end
            end
        end
        Theme.Accent = new
        Theme.AccentLight = newLight
    end)
end

