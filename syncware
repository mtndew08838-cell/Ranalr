function freezeBlobman(p124)
	if p124 and p124.PrimaryPart then
		if FreezedBlobs[p124] then
			return
		else
			FreezedBlobs[p124] = true

			local BodyVelocity = Instance.new("BodyVelocity")

			BodyVelocity.Name = "AutoFreezeVelocity"
			BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			BodyVelocity.Velocity = Vector3.zero
			BodyVelocity.P = 10000
			BodyVelocity.Parent = p124.PrimaryPart

			local BodyGyro = Instance.new("BodyGyro")

			BodyGyro.Name = "AutoFreezeGyro"
			BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
			BodyGyro.P = 10000
			BodyGyro.D = 500
			BodyGyro.CFrame = p124.PrimaryPart.CFrame
			BodyGyro.Parent = p124.PrimaryPart

			return
		end
	end
end
function unfreezeBlobman(p125)
	if not (p125 and p125.PrimaryPart) then
