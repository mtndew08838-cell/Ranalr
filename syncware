        end

        overlay.Visible = true
        summary.Text = string.format("%d result%s for \"%s\"", #matches, #matches == 1 and "" or "s", box.Text)
        emptyHolder.Visible = #matches == 0
        emptyCaption.Text = "No elements match \"" .. box.Text .. "\""

